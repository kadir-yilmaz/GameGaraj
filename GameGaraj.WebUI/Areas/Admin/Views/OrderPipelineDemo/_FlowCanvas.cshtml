<div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3 mb-3 overflow-hidden">
    <div class="card-header bg-light border-bottom border-secondary border-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark small">Boru Hattı Akışı</span>
        <div id="pipeline-status-text" class="badge bg-secondary px-3 py-1">Beklemede</div>
    </div>
    <div class="card-body p-4 bg-dark bg-opacity-95 position-relative" style="min-height: 210px;">
        <div class="pipeline-flow-deck d-flex flex-wrap align-items-center justify-content-between position-relative py-2">
            <div class="pipeline-node text-center" id="node-webui">
                <div class="node-icon bg-primary text-white shadow fw-bold">1</div>
                <div class="node-title text-light mt-2 small fw-bold">WebUI</div>
                <div class="node-sub text-secondary extra-small">Test Sepeti</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Hazır</span></div>
            </div>

            <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-1">
                <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Validate</div>
            </div>

            <div class="pipeline-node text-center" id="node-catalog">
                <div class="node-icon bg-dark border border-secondary text-secondary shadow fw-bold">2</div>
                <div class="node-title text-light mt-2 small fw-bold">Catalog.API</div>
                <div class="node-sub text-secondary extra-small">Stok Rezerve</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
            </div>

            <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-2">
                <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Create</div>
            </div>

            <div class="pipeline-node text-center" id="node-order">
                <div class="node-icon bg-dark border border-secondary text-secondary shadow fw-bold">3</div>
                <div class="node-title text-light mt-2 small fw-bold">Order.API</div>
                <div class="node-sub text-secondary extra-small">DB + Outbox</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
            </div>

            <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-3">
                <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Pay</div>
            </div>

            <div class="pipeline-node text-center" id="node-payment">
                <div class="node-icon bg-dark border border-secondary text-secondary shadow fw-bold">4</div>
                <div class="node-title text-light mt-2 small fw-bold">Payment.API</div>
                <div class="node-sub text-secondary extra-small">İyzico Gateway</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
            </div>

            <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-4">
                <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">Event Publish</div>
            </div>

            <div class="pipeline-node text-center" id="node-rabbitmq">
                <div class="node-icon bg-dark border border-secondary text-secondary shadow fw-bold">5</div>
                <div class="node-title text-light mt-2 small fw-bold">RabbitMQ</div>
                <div class="node-sub text-secondary extra-small">MassTransit</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
            </div>

            <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-5">
                <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">Downstream</div>
            </div>

            <div class="pipeline-node text-center" id="node-downstream">
                <div class="node-icon bg-dark border border-secondary text-secondary shadow fw-bold">6</div>
                <div class="node-title text-light mt-2 small fw-bold">Tamamlandı</div>
                <div class="node-sub text-secondary extra-small">Stok/Fatura/Mail</div>
                <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
            </div>
        </div>
    </div>
</div>
