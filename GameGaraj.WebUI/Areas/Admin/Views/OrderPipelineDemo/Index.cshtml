@model List<GameGaraj.WebUI.Areas.Admin.Models.PipelineScenarioViewModel>
@{
    ViewData["Title"] = "Sipariş Pipeline Senaryoları";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-2 px-md-4 py-3">
    <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <h2 class="h4 fw-bold text-dark mb-1">Sipariş Pipeline &amp; Chaos Senaryoları</h2>
        <p class="text-muted mb-0 small">
            Test etmek istediğiniz senaryoyu seçin. Her senaryoda amacını, beklenen DB davranışını ve canlı akışı inceleyebilirsiniz.
        </p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var item in Model)
        {
            <div class="col">
                <a asp-area="Admin" asp-controller="OrderPipelineDemo" asp-action="Scenario" asp-route-key="@item.Key"
                   class="card h-100 text-decoration-none border border-secondary border-opacity-25 shadow-sm rounded-3 scenario-card bg-white">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge @item.BadgeClass px-2 py-1 small fw-semibold">@item.Category</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">@item.Title</h5>
                        <p class="text-muted small mb-4 flex-grow-1">@item.Summary</p>
                        <div class="pt-2 border-top border-secondary border-opacity-10">
                            <span class="text-primary small fw-semibold">Senaryoyu Aç &rarr;</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .scenario-card {
        transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .scenario-card:hover {
        transform: translateY(-2px);
        border-color: #3b82f6 !important;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08) !important;
    }
</style>
