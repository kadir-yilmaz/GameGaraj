@{
    ViewData["Title"] = "Sipariş Pipeline & Chaos Simülatörü";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var catalogProducts = ViewBag.Products as List<GameGaraj.WebUI.Models.Products.ProductViewModel> ?? new List<GameGaraj.WebUI.Models.Products.ProductViewModel>();
    var services = new[]
    {
        new { Key = "catalog", Name = "Catalog.API", Icon = "fa-cubes text-info" },
        new { Key = "order", Name = "Order.API", Icon = "fa-file-invoice text-warning" },
        new { Key = "payment", Name = "Payment.API", Icon = "fa-credit-card text-success" },
        new { Key = "invoice", Name = "Invoice.API", Icon = "fa-receipt text-info" },
        new { Key = "notification", Name = "Notification", Icon = "fa-envelope text-primary" },
        new { Key = "campaign", Name = "Campaign.API", Icon = "fa-gift text-danger" }
    };
}

<div class="container-fluid px-2 px-md-4 py-3">

    <!-- 1. Başlık -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-25 gap-2">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fa-solid fa-diagram-project text-primary"></i>
                <span>Sipariş Pipeline &amp; Chaos Simülatörü</span>
            </h2>
            <p class="text-muted mb-0 small">
                Saga akışı, Polly Retry, Compensate (Rollback) ve gerçek DB durumunu adım adım test edin.
            </p>
        </div>
        <button class="btn btn-outline-danger btn-sm px-3 rounded-2 fw-semibold" onclick="resetAllChaos()">
            <i class="fa-solid fa-rotate-left me-1"></i>Vanaları Sıfırla
        </button>
    </div>

    <!-- 2. Servis Vanaları & Senaryolar -->
    <div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3 mb-3">
        <div class="card-header bg-light border-bottom border-secondary border-opacity-25 d-flex flex-wrap justify-content-between align-items-center py-2 px-3 gap-2">
            <span class="fw-bold text-dark small d-flex align-items-center gap-2">
                <i class="fa-solid fa-sliders text-primary"></i>
                <span>Servis Vanaları</span>
            </span>
            <div class="d-flex flex-wrap gap-1">
                <button class="btn btn-outline-success btn-sm extra-small rounded-pill fw-semibold px-2" onclick="applyPreset('normal')">Normal Akış</button>
                <button class="btn btn-outline-warning btn-sm extra-small rounded-pill fw-semibold px-2" onclick="applyPreset('polly_retry')">Polly Retry Testi</button>
                <button class="btn btn-outline-primary btn-sm extra-small rounded-pill fw-semibold px-2" onclick="applyPreset('latency')">3sn Gecikme</button>
                <button class="btn btn-outline-secondary btn-sm extra-small rounded-pill fw-semibold px-2" onclick="applyPreset('nostock')">Stok Yok Koruması</button>
                <button class="btn btn-outline-danger btn-sm extra-small rounded-pill fw-semibold px-2" onclick="applyPreset('compensate')">Compensate / Rollback</button>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-2">
                @foreach (var svc in services)
                {
                    <div class="col">
                        <div class="valve-box p-2 rounded-3 border border-secondary border-opacity-25 bg-white h-100">
                            <div class="d-flex align-items-center gap-1 mb-2">
                                <i class="fa-solid @svc.Icon extra-small"></i>
                                <span class="text-dark fw-bold extra-small text-truncate">@svc.Name</span>
                            </div>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="@svc.Name Modu">
                                <input type="radio" class="btn-check" name="radio-@svc.Key" id="radio-@svc.Key-normal" value="normal" checked onchange="updateServiceChaosRadio('@svc.Key', 'normal')">
                                <label class="btn btn-outline-success extra-small py-1 px-1 fw-semibold" for="radio-@svc.Key-normal" title="Servis normal çalışır">Aktif</label>

                                <input type="radio" class="btn-check" name="radio-@svc.Key" id="radio-@svc.Key-retry" value="retry" onchange="updateServiceChaosRadio('@svc.Key', 'retry')">
                                <label class="btn btn-outline-warning extra-small py-1 px-1 fw-semibold" for="radio-@svc.Key-retry" title="İlk 2 istek 503 döner, 3. istekte Polly Retry ile kurtarılır">Retry</label>

                                <input type="radio" class="btn-check" name="radio-@svc.Key" id="radio-@svc.Key-latency" value="latency" onchange="updateServiceChaosRadio('@svc.Key', 'latency')">
                                <label class="btn btn-outline-primary extra-small py-1 px-1 fw-semibold" for="radio-@svc.Key-latency" title="3 saniye gecikme ekler">3sn</label>

                                <input type="radio" class="btn-check" name="radio-@svc.Key" id="radio-@svc.Key-blocked" value="blocked" onchange="updateServiceChaosRadio('@svc.Key', 'blocked')">
                                <label class="btn btn-outline-danger extra-small py-1 px-1 fw-semibold" for="radio-@svc.Key-blocked" title="Servis tamamen uykuda (tüm istekler 503)">Uykuda</label>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Test Verisi & Kontroller -->
    <div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3 mb-3">
        <div class="card-body p-3">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <label class="text-muted extra-small fw-bold text-uppercase mb-1 d-block">Test Ürünü (Catalog DB)</label>
                    <select id="select-catalog-product" class="form-select form-select-sm" onchange="onCatalogProductChanged()">
                        @foreach (var p in catalogProducts)
                        {
                            <option value="@p.Id"
                                    data-name="@p.Name"
                                    data-price="@p.Price"
                                    data-stock="@p.AvailableStock"
                                    data-img="@p.FirstImageUrl"
                                    selected="@(p.Name.Contains("14700K", StringComparison.OrdinalIgnoreCase))">
                                @p.Name — ₺@p.Price.ToString("N0") (Mevcut Stok: @p.AvailableStock)
                            </option>
                        }
                        <option value="custom" data-name="Olmayan / Silinmiş Ürün" data-price="5000" data-stock="0" data-img="/default.jpg">
                            Özel / Silinmiş Ürün (GUID Hata Testi)
                        </option>
                    </select>

                    <div id="custom-product-panel" class="p-2 mt-2 rounded bg-light border border-secondary border-opacity-25 d-none">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label text-muted extra-small mb-1">Product ID (GUID)</label>
                                <input type="text" id="custom-prod-id" class="form-control form-control-sm font-monospace" value="00000000-0000-0000-0000-000000000000" oninput="syncCustomProduct()" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted extra-small mb-1">Ürün Adı</label>
                                <input type="text" id="custom-prod-name" class="form-control form-control-sm" value="Silinmiş Test Ürünü" oninput="syncCustomProduct()" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted extra-small mb-1">Fiyat</label>
                                <input type="number" id="custom-prod-price" class="form-control form-control-sm" value="5000" oninput="syncCustomProduct()" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <label class="text-muted extra-small fw-bold text-uppercase mb-1 d-block">Ödeme Kartı</label>
                    <select id="select-card-quick" class="form-select form-select-sm" onchange="updateDemoCard()">
                        <option value="5528790000000008">Geçerli Kart (5528 ... 0008)</option>
                        <option value="5528790000000001">Yetersiz Bakiye (Compensate Testi)</option>
                    </select>
                </div>

                <div class="col-lg-3 d-flex gap-2 justify-content-lg-end">
                    <button id="btn-play" class="btn btn-warning btn-sm fw-bold px-3 rounded-2 flex-grow-1 flex-lg-grow-0" onclick="startFullPipeline()">
                        <i class="fa-solid fa-play me-1"></i>Otomatik
                    </button>
                    <button id="btn-step" class="btn btn-primary btn-sm fw-bold px-3 rounded-2 flex-grow-1 flex-lg-grow-0" onclick="stepPipeline()">
                        <i class="fa-solid fa-forward-step me-1"></i>Adım
                    </button>
                    <button id="btn-reset" class="btn btn-outline-secondary btn-sm px-3 rounded-2" onclick="resetPipelineUI()" title="Akışı Sıfırla">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Boru Hattı Akışı -->
    <div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3 mb-3 overflow-hidden">
        <div class="card-header bg-light border-bottom border-secondary border-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark small d-flex align-items-center gap-2">
                <i class="fa-solid fa-wave-square text-primary"></i>
                <span>Boru Hattı Akışı</span>
            </span>
            <div id="pipeline-status-text" class="badge bg-secondary px-3 py-1">Beklemede</div>
        </div>
        <div class="card-body p-4 bg-dark bg-opacity-95 position-relative" style="min-height: 220px;">
            <div class="pipeline-flow-deck d-flex flex-wrap align-items-center justify-content-between position-relative py-2">
                <div class="pipeline-node text-center" id="node-webui">
                    <div class="node-icon bg-primary text-white shadow"><i class="fa-solid fa-cart-shopping"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">1. WebUI</div>
                    <div class="node-sub text-secondary extra-small">Test Sepeti</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Hazır</span></div>
                </div>

                <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-1">
                    <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Validate</div>
                </div>

                <div class="pipeline-node text-center" id="node-catalog">
                    <div class="node-icon bg-dark border border-secondary text-info shadow"><i class="fa-solid fa-cubes-stacked"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">2. Catalog.API</div>
                    <div class="node-sub text-secondary extra-small">Stok Rezerve</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
                </div>

                <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-2">
                    <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Create</div>
                </div>

                <div class="pipeline-node text-center" id="node-order">
                    <div class="node-icon bg-dark border border-secondary text-warning shadow"><i class="fa-solid fa-file-invoice"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">3. Order.API</div>
                    <div class="node-sub text-secondary extra-small">DB + Outbox</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
                </div>

                <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-3">
                    <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">HTTP Pay</div>
                </div>

                <div class="pipeline-node text-center" id="node-payment">
                    <div class="node-icon bg-dark border border-secondary text-success shadow"><i class="fa-solid fa-credit-card"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">4. Payment.API</div>
                    <div class="node-sub text-secondary extra-small">İyzico Gateway</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
                </div>

                <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-4">
                    <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">Event Publish</div>
                </div>

                <div class="pipeline-node text-center" id="node-rabbitmq">
                    <div class="node-icon bg-dark border border-warning text-warning shadow"><i class="fa-solid fa-arrows-split-up-and-left"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">5. RabbitMQ</div>
                    <div class="node-sub text-secondary extra-small">MassTransit</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
                </div>

                <div class="pipeline-tube flex-grow-1 position-relative" id="pipe-5">
                    <div class="tube-track"></div><div class="tube-fluid"></div><div class="tube-label">Downstream</div>
                </div>

                <div class="pipeline-node text-center" id="node-downstream">
                    <div class="node-icon bg-dark border border-success text-success shadow"><i class="fa-solid fa-check-double"></i></div>
                    <div class="node-title text-light mt-2 small fw-bold">6. Tamamlandı</div>
                    <div class="node-sub text-secondary extra-small">Stok/Fatura/Mail</div>
                    <div class="node-badge mt-1"><span class="badge bg-secondary">Bekliyor</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Canlı Veritabanı Durumu -->
    <div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3 mb-3">
        <div class="card-header bg-light border-bottom border-secondary border-opacity-25 py-2 px-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark small d-flex align-items-center gap-2">
                <i class="fa-solid fa-database text-success"></i>
                <span>Canlı Veritabanı Durumu</span>
            </span>
            <button class="btn btn-outline-secondary btn-sm extra-small py-0 px-2" onclick="refreshDbSnapshot(true)">
                <i class="fa-solid fa-arrows-rotate me-1"></i>DB Yenile
            </button>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-2 px-3 rounded-3 border bg-light bg-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="extra-small fw-bold text-muted text-uppercase">Catalog DB (MongoDB) — Stok</div>
                            <div id="db-catalog-values" class="small fw-semibold text-dark mt-1">Yükleniyor...</div>
                        </div>
                        <span id="db-catalog-delta" class="badge bg-secondary extra-small">Başlangıç</span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-2 px-3 rounded-3 border bg-light bg-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div>
                            <div class="extra-small fw-bold text-muted text-uppercase">Order DB (MSSQL) — Sipariş</div>
                            <div id="db-order-values" class="small fw-semibold text-dark mt-1">Henüz sipariş oluşturulmadı</div>
                        </div>
                        <span id="db-order-badge" class="badge bg-secondary extra-small">Bekliyor</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 6. Konsol (Sekmeli) -->
    <div class="card bg-white border border-secondary border-opacity-25 shadow-sm rounded-3">
        <div class="card-header bg-light border-bottom border-secondary border-opacity-25 py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <ul class="nav nav-pills gap-1" id="console-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active py-1 px-3 extra-small fw-semibold" id="tab-sim-btn" data-bs-toggle="pill" data-bs-target="#tab-sim" type="button" role="tab">
                        Simülasyon &amp; Polly <span class="badge bg-secondary ms-1" id="badge-demo-count">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link py-1 px-3 extra-small fw-semibold d-flex align-items-center gap-1" id="tab-live-btn" data-bs-toggle="pill" data-bs-target="#tab-live" type="button" role="tab">
                        <span id="signalr-dot" class="pulse-dot bg-secondary"></span>
                        <span>Gerçek Site</span>
                        <span class="badge bg-success ms-1" id="badge-live-count">0</span>
                    </button>
                </li>
            </ul>
            <button class="btn btn-link btn-sm text-secondary text-decoration-none p-0 extra-small" onclick="clearActiveConsole()">
                <i class="fa-solid fa-trash-can me-1"></i>Temizle
            </button>
        </div>
        <div class="card-body p-0 bg-black">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-sim" role="tabpanel">
                    <div id="log-console-demo" class="p-3 font-monospace small text-light terminal-box">
                        <div class="text-secondary">[Sistem] Simülatör hazır. 'Otomatik' veya 'Adım' ile testi başlatabilirsiniz.</div>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-live" role="tabpanel">
                    <div id="log-console-live" class="p-3 font-monospace small text-light terminal-box">
                        <div class="text-secondary">[SignalR] Gerçek siteden (/order/checkout) gelen sipariş olayları burada listelenir.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<style>
    .valve-box { transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .valve-box:hover { border-color: #3b82f6 !important; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); }
    .pulse-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; }
    .pulse-dot.connected { background-color: #10b981 !important; box-shadow: 0 0 6px #10b981; animation: pulseDot 1.5s infinite; }
    @@keyframes pulseDot {
        0% { transform: scale(0.95); opacity: 0.7; }
        50% { transform: scale(1.25); opacity: 1; }
        100% { transform: scale(0.95); opacity: 0.7; }
    }
    .extra-small { font-size: 0.72rem; }
    .pipeline-node { width: 95px; z-index: 2; }
    .node-icon {
        width: 46px; height: 46px; margin: 0 auto; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.15rem; transition: all 0.3s ease;
    }
    .node-icon.active { box-shadow: 0 0 18px #00f0ff !important; transform: scale(1.12); border-color: #00f0ff !important; }
    .node-icon.success { background-color: #10b981 !important; border-color: #10b981 !important; box-shadow: 0 0 16px rgba(16, 185, 129, 0.7) !important; }
    .node-icon.failed {
        background-color: #ef4444 !important; border-color: #ef4444 !important;
        box-shadow: 0 0 20px rgba(239, 68, 68, 0.85) !important;
        animation: pulseFailed 1s infinite alternate;
    }
    .pipeline-tube { height: 8px; margin: 0 5px; top: -15px; min-width: 50px; }
    .tube-track { position: absolute; inset: 0; background: #1e293b; border-radius: 4px; border: 1px solid #334155; }
    .tube-fluid {
        position: absolute; top: 1px; left: 0; width: 0%; height: 6px; border-radius: 3px;
        background: linear-gradient(90deg, #3b82f6, #00f0ff); box-shadow: 0 0 10px #00f0ff;
        transition: width 0.5s ease;
    }
    .tube-fluid.flowing { width: 100%; }
    .tube-fluid.blocked { width: 50% !important; background: linear-gradient(90deg, #ef4444, #f97316) !important; box-shadow: 0 0 14px #ef4444 !important; }
    .tube-label { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); font-size: 0.65rem; color: #94a3b8; white-space: nowrap; }
    .terminal-box { height: 260px; overflow-y: auto; font-size: 0.81rem; line-height: 1.5; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
    @@keyframes pulseFailed { from { transform: scale(1); } to { transform: scale(1.12); } }
</style>

<script>
    let currentStep = 0;
    let isRunning = false;
    let fullPipelineStartTime = 0;
    let baselineCatalog = null;

    let testOrderData = {
        productId: '7bd6ed51-c13f-46fd-9602-293979dc61fd',
        productName: 'Intel Core i7-14700K',
        pictureUrl: '/default.jpg',
        quantity: 1,
        totalPrice: 15500,
        orderId: 0,
        cardNumber: '5528790000000008',
        cardName: 'Kadir Yilmaz'
    };

    const steps = [
        { key: 'stock_validate', name: 'Catalog Stok Doğrulama', node: 'node-catalog', pipe: 'pipe-1' },
        { key: 'order_create', name: 'Order DB & Outbox', node: 'node-order', pipe: 'pipe-2' },
        { key: 'payment_process', name: 'İyzico Ödeme İşlemi', node: 'node-payment', pipe: 'pipe-3' },
        { key: 'rabbitmq_events', name: 'RabbitMQ Dağıtımı & Downstream', node: 'node-rabbitmq', pipe: 'pipe-4' }
    ];

    document.addEventListener('DOMContentLoaded', () => {
        onCatalogProductChanged();
    });

    function onCatalogProductChanged() {
        const select = document.getElementById('select-catalog-product');
        const customPanel = document.getElementById('custom-product-panel');
        const val = select.value;

        if (val === 'custom') {
            customPanel.classList.remove('d-none');
            syncCustomProduct();
        } else {
            customPanel.classList.add('d-none');
            const opt = select.options[select.selectedIndex];
            testOrderData.productId = val;
            testOrderData.productName = opt.getAttribute('data-name');
            testOrderData.totalPrice = parseFloat(opt.getAttribute('data-price')) || 15500;
            testOrderData.pictureUrl = opt.getAttribute('data-img') || '/default.jpg';
            resetPipelineUI();
        }
    }

    function syncCustomProduct() {
        testOrderData.productId = document.getElementById('custom-prod-id').value.trim() || '00000000-0000-0000-0000-000000000000';
        testOrderData.productName = document.getElementById('custom-prod-name').value.trim() || 'Silinmiş Test Ürünü';
        testOrderData.totalPrice = parseFloat(document.getElementById('custom-prod-price').value) || 5000;
        testOrderData.pictureUrl = '/default.jpg';

        resetPipelineUI(false);
        document.getElementById('db-catalog-values').innerText = 'Özel GUID seçildi (DB kaydı yok)';
        document.getElementById('db-catalog-delta').className = 'badge bg-secondary extra-small';
        document.getElementById('db-catalog-delta').innerText = 'Özel';
    }

    function updateDemoCard() {
        testOrderData.cardNumber = document.getElementById('select-card-quick').value;
        const label = testOrderData.cardNumber === '5528790000000001'
            ? 'Yetersiz Bakiye Kartı (Compensate / Rollback Testi)'
            : 'Geçerli Kart';
        logMessage('Kart', `Kart seçildi: ${label}`, 'info');
    }

    let demoEventCount = 0;
    let liveEventCount = 0;

    function stripEmojis(str) {
        return (str || '').replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE0F}]/gu, '').trim();
    }

    function colorFor(type, fallback) {
        if (type === 'success') return 'text-success';
        if (type === 'error') return 'text-danger';
        if (type === 'warning') return 'text-warning';
        if (type === 'info') return 'text-info';
        return fallback;
    }

    function appendLog(consoleId, sender, text, type, fallbackColor) {
        const consoleEl = document.getElementById(consoleId);
        if (!consoleEl) return false;
        const timestamp = new Date().toLocaleTimeString();
        const line = document.createElement('div');
        line.innerHTML = `<span class="text-secondary">[${timestamp}]</span> <span class="fw-bold ${colorFor(type, fallbackColor)}">[${stripEmojis(sender)}]</span> ${stripEmojis(text)}`;
        consoleEl.appendChild(line);
        consoleEl.scrollTop = consoleEl.scrollHeight;
        return true;
    }

    function logDemoMessage(sender, text, type = 'info') {
        if (!appendLog('log-console-demo', sender, text, type, 'text-info')) return;
        demoEventCount++;
        document.getElementById('badge-demo-count').innerText = demoEventCount;
    }

    function logLiveMessage(sender, text, type = 'info') {
        if (!appendLog('log-console-live', sender, text, type, 'text-success')) return;
        liveEventCount++;
        document.getElementById('badge-live-count').innerText = liveEventCount;
    }

    function logMessage(sender, text, type = 'info') {
        logDemoMessage(sender, text, type);
    }

    function clearActiveConsole() {
        if (document.getElementById('tab-sim').classList.contains('active')) {
            document.getElementById('log-console-demo').innerHTML = '';
            demoEventCount = 0;
            document.getElementById('badge-demo-count').innerText = '0';
        } else {
            document.getElementById('log-console-live').innerHTML = '';
            liveEventCount = 0;
            document.getElementById('badge-live-count').innerText = '0';
        }
    }

    async function refreshDbSnapshot(logChange = false, setAsBaseline = false) {
        try {
            const url = `/Admin/OrderPipelineDemo/GetDbSnapshot?productId=${encodeURIComponent(testOrderData.productId)}&orderId=${testOrderData.orderId || 0}`;
            const res = await fetch(url);
            if (!res.ok || res.redirected) return;
            const data = await res.json();

            const catValEl = document.getElementById('db-catalog-values');
            const catDeltaEl = document.getElementById('db-catalog-delta');

            if (data.catalog) {
                if (data.catalog.available) {
                    const c = data.catalog;
                    if (setAsBaseline || !baselineCatalog || baselineCatalog.productId !== c.productId) {
                        baselineCatalog = { productId: c.productId, stock: c.stock, reservedStock: c.reservedStock };
                    }

                    catValEl.innerHTML = `Stok: <b>${c.stock}</b> &bull; Rezerve: <b>${c.reservedStock}</b> &bull; Kullanılabilir: <b>${c.availableStock}</b>`;

                    const dStock = c.stock - baselineCatalog.stock;
                    const dReserve = c.reservedStock - baselineCatalog.reservedStock;

                    if (dReserve > 0) {
                        catDeltaEl.className = 'badge bg-warning text-dark extra-small';
                        catDeltaEl.innerText = `Rezerve +${dReserve}`;
                    } else if (dStock < 0) {
                        catDeltaEl.className = 'badge bg-success extra-small';
                        catDeltaEl.innerText = `Stok Düştü (${dStock})`;
                    } else if (currentStep > 0 || testOrderData.orderId > 0) {
                        catDeltaEl.className = 'badge bg-info text-dark extra-small';
                        catDeltaEl.innerText = 'Değişmedi / İade Edildi';
                    } else {
                        catDeltaEl.className = 'badge bg-secondary extra-small';
                        catDeltaEl.innerText = 'Başlangıç';
                    }

                    if (logChange) {
                        logMessage('DB Catalog', `Stok=${c.stock}, Rezerve=${c.reservedStock}, Kullanılabilir=${c.availableStock}`, 'info');
                    }
                } else {
                    catValEl.innerText = data.catalog.reason || 'Okunamadı';
                    catDeltaEl.className = 'badge bg-danger extra-small';
                    catDeltaEl.innerText = 'Erişilemiyor';
                }
            }

            const ordValEl = document.getElementById('db-order-values');
            const ordBadgeEl = document.getElementById('db-order-badge');

            if (testOrderData.orderId > 0 && data.order) {
                if (data.order.available) {
                    const o = data.order;
                    ordValEl.innerHTML = `Sipariş <b>#${o.orderId}</b> &bull; Tutar: <b>₺${Number(o.totalPaidAmount).toLocaleString('tr-TR')}</b>`;
                    ordBadgeEl.innerText = o.statusText;
                    if (o.status === 1) ordBadgeEl.className = 'badge bg-success extra-small';
                    else if (o.status === 2) ordBadgeEl.className = 'badge bg-danger extra-small';
                    else if (o.status === 0) ordBadgeEl.className = 'badge bg-warning text-dark extra-small';
                    else ordBadgeEl.className = 'badge bg-info extra-small';

                    if (logChange) {
                        logMessage('DB Order', `Sipariş #${o.orderId} statü: ${o.statusText}`, o.status === 2 ? 'warning' : 'info');
                    }
                } else {
                    ordValEl.innerText = data.order.reason;
                    ordBadgeEl.className = 'badge bg-secondary extra-small';
                    ordBadgeEl.innerText = 'Bulunamadı';
                }
            } else if (!testOrderData.orderId) {
                ordValEl.innerText = 'Henüz sipariş oluşturulmadı';
                ordBadgeEl.className = 'badge bg-secondary extra-small';
                ordBadgeEl.innerText = 'Bekliyor';
            }
        } catch { }
    }

    function setServiceRadio(service, val) {
        const radio = document.getElementById(`radio-${service}-${val}`);
        if (radio) radio.checked = true;
    }

    async function updateServiceChaosRadio(service, val) {
        const rule = {
            serviceName: service,
            enabled: val !== 'normal',
            alwaysFail: val === 'blocked',
            failUntilAttempt: val === 'retry' ? 3 : 0,
            latencyMs: val === 'latency' ? 3000 : 0,
            blockPipeline: val === 'blocked'
        };

        try {
            const res = await fetch('/Admin/OrderPipelineDemo/SetRule', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(rule)
            });

            if (!res.ok || res.redirected) {
                if (res.status === 401 || res.status === 403 || res.redirected) {
                    logMessage('ChaosManager', 'Oturum süresi dolmuş olabilir. Sayfayı yenileyin.', 'warning');
                    return;
                }
                throw new Error(`HTTP ${res.status}`);
            }

            const modeLabel = {
                normal: 'Aktif',
                retry: 'Polly Retry (ilk 2 deneme 503, 3. başarılı)',
                latency: '3sn Gecikme',
                blocked: 'Uykuda (503)'
            }[val];
            const logType = val === 'normal' ? 'success' : (val === 'blocked' ? 'error' : 'warning');
            logMessage('ChaosManager', `${service.toUpperCase()} -> ${modeLabel}`, logType);
        } catch (err) {
            logMessage('ChaosManager', `Kural güncellenemedi: ${err.message || err}`, 'error');
        }
    }

    function selectFirstInStockProduct() {
        const select = document.getElementById('select-catalog-product');
        for (let i = 0; i < select.options.length; i++) {
            const stock = parseInt(select.options[i].getAttribute('data-stock') || '0', 10);
            if (select.options[i].value !== 'custom' && stock > 0) {
                select.selectedIndex = i;
                break;
            }
        }
        onCatalogProductChanged();
    }

    async function applyPreset(preset) {
        await resetAllChaos(false);
        document.getElementById('select-card-quick').value = '5528790000000008';
        testOrderData.cardNumber = '5528790000000008';

        if (preset === 'normal') {
            selectFirstInStockProduct();
            logMessage('Senaryo', 'Normal Akış: tüm servisler sağlıklı, stoklu ürün ve geçerli kart seçildi.', 'success');
        } else if (preset === 'polly_retry') {
            selectFirstInStockProduct();
            setServiceRadio('catalog', 'retry');
            await updateServiceChaosRadio('catalog', 'retry');
            logMessage('Senaryo', 'Polly Retry: Catalog.API ilk 2 istekte 503 dönecek, Polly 3. denemede isteği kurtaracak. Adım 1 yaklaşık 6 sn sürer (2s + 4s backoff).', 'warning');
        } else if (preset === 'latency') {
            selectFirstInStockProduct();
            setServiceRadio('catalog', 'latency');
            await updateServiceChaosRadio('catalog', 'latency');
            logMessage('Senaryo', '3sn Gecikme: Catalog.API her isteğe 3 sn gecikme ekleyecek.', 'info');
        } else if (preset === 'nostock') {
            const select = document.getElementById('select-catalog-product');
            let found = false;
            for (let i = 0; i < select.options.length; i++) {
                if (select.options[i].value !== 'custom' && select.options[i].getAttribute('data-stock') === '0') {
                    select.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            if (!found) select.value = 'custom';
            onCatalogProductChanged();
            logMessage('Senaryo', 'Stok Yok Koruması: 0 stoklu ürün seçildi. Akış Catalog adımında durmalı, ödemeye geçilmemeli.', 'warning');
        } else if (preset === 'compensate') {
            selectFirstInStockProduct();
            document.getElementById('select-card-quick').value = '5528790000000001';
            testOrderData.cardNumber = '5528790000000001';
            logMessage('Senaryo', 'Compensate: Stok rezerve edilip sipariş açılacak, ödeme yetersiz bakiyeden reddedilecek. Beklenen: rezerve stok iade, sipariş Failed.', 'warning');
        }
    }

    async function resetAllChaos(log = true) {
        ['catalog', 'order', 'payment', 'invoice', 'notification', 'campaign'].forEach(s => setServiceRadio(s, 'normal'));
        try {
            await fetch('/Admin/OrderPipelineDemo/ResetAllRules', { method: 'POST' });
            if (log) logMessage('ChaosManager', 'Tüm vanalar normale döndürüldü.', 'success');
        } catch { }
    }

    function resetPipelineUI(refreshDb = true) {
        currentStep = 0;
        isRunning = false;
        fullPipelineStartTime = 0;
        testOrderData.orderId = 0;
        baselineCatalog = null;

        const statusEl = document.getElementById('pipeline-status-text');
        statusEl.className = 'badge bg-secondary px-3 py-1';
        statusEl.innerText = 'Beklemede';

        for (let i = 1; i <= 5; i++) {
            const tube = document.querySelector(`#pipe-${i} .tube-fluid`);
            if (tube) tube.className = 'tube-fluid';
        }

        ['node-catalog', 'node-order', 'node-payment', 'node-rabbitmq', 'node-downstream'].forEach(n => {
            const nodeEl = document.getElementById(n);
            if (!nodeEl) return;
            nodeEl.querySelector('.node-icon').className = 'node-icon bg-dark border border-secondary text-secondary shadow';
            const badge = nodeEl.querySelector('.node-badge span');
            badge.className = 'badge bg-secondary';
            badge.innerText = 'Bekliyor';
        });

        document.querySelector('#node-webui .node-icon').className = 'node-icon bg-primary text-white shadow';
        const webuiBadge = document.querySelector('#node-webui .node-badge span');
        webuiBadge.className = 'badge bg-success';
        webuiBadge.innerText = 'Hazır';

        if (refreshDb) refreshDbSnapshot(false, true);
    }

    function setStatus(cls, text) {
        const el = document.getElementById('pipeline-status-text');
        el.className = `badge ${cls} px-3 py-1`;
        el.innerText = text;
    }

    async function stepPipeline() {
        if (currentStep >= steps.length) {
            logMessage('Pipeline', 'Akış zaten tamamlandı. Yeniden başlatmak için sıfırlayın.', 'success');
            return false;
        }

        if (currentStep === 0 && fullPipelineStartTime === 0) {
            fullPipelineStartTime = performance.now();
            await refreshDbSnapshot(false, true);
        }

        const step = steps[currentStep];
        const pipeEl = document.querySelector(`#${step.pipe} .tube-fluid`);
        const nodeEl = document.getElementById(step.node);
        const iconEl = nodeEl.querySelector('.node-icon');
        const badgeEl = nodeEl.querySelector('.node-badge span');

        pipeEl?.classList.add('flowing');
        iconEl?.classList.add('active');
        badgeEl.className = 'badge bg-info';
        badgeEl.innerText = 'İşleniyor...';
        setStatus('bg-primary', `Adım ${currentStep + 1}/4`);

        logMessage('Pipeline', `[Adım ${currentStep + 1}/4] ${step.name} çağrılıyor...`, 'info');

        try {
            const res = await fetch('/Admin/OrderPipelineDemo/ExecuteStep', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    stepKey: step.key,
                    stepName: step.name,
                    productId: testOrderData.productId,
                    productName: testOrderData.productName,
                    pictureUrl: testOrderData.pictureUrl,
                    quantity: testOrderData.quantity,
                    totalPrice: testOrderData.totalPrice,
                    orderId: testOrderData.orderId,
                    cardNumber: testOrderData.cardNumber,
                    cardName: testOrderData.cardName
                })
            });

            if (!res.ok || res.redirected) {
                if (res.status === 401 || res.status === 403 || res.redirected) {
                    logMessage('Pipeline', 'Oturum süresi dolmuş olabilir. Sayfayı yenileyin.', 'warning');
                    return false;
                }
                throw new Error(`HTTP ${res.status}`);
            }

            const result = await res.json();

            if (result.success) {
                iconEl.className = 'node-icon success text-white';
                badgeEl.className = 'badge bg-success';
                badgeEl.innerText = `OK (${result.durationMs}ms)`;
                logMessage('Pipeline', `${step.name}: ${result.message} (${result.durationMs}ms)`, 'success');

                if (step.key === 'order_create' && result.payload && result.payload.orderId) {
                    testOrderData.orderId = result.payload.orderId;
                }

                currentStep++;
                await refreshDbSnapshot(true, false);

                if (currentStep === steps.length) {
                    const finalNode = document.getElementById('node-downstream');
                    finalNode.querySelector('.node-icon').className = 'node-icon success text-white';
                    const finalBadge = finalNode.querySelector('.node-badge span');
                    finalBadge.className = 'badge bg-success';
                    finalBadge.innerText = 'Tamamlandı';
                    document.querySelector('#pipe-5 .tube-fluid')?.classList.add('flowing');

                    setStatus('bg-success', 'Başarılı');
                    const totalTimeSec = ((performance.now() - fullPipelineStartTime) / 1000).toFixed(2);
                    logMessage('Saga', `Sipariş akışı tamamlandı. Toplam süre: ${totalTimeSec} sn. Downstream (stok düşümü) kontrol ediliyor...`, 'success');
                    fullPipelineStartTime = 0;

                    setTimeout(() => refreshDbSnapshot(true, false), 1500);
                }
                return true;
            }

            pipeEl.className = 'tube-fluid blocked';
            iconEl.className = 'node-icon failed text-white';
            badgeEl.className = 'badge bg-danger';
            badgeEl.innerText = `Hata (${result.statusCode})`;
            logMessage('Pipeline', `${step.name} durdu: ${result.message}`, 'error');
            setStatus('bg-danger', 'Hata / Durduruldu');

            if (step.key === 'stock_validate') {
                logMessage('Saga Koruması', 'Stok doğrulanamadığı için akış durduruldu. Ödeme adımına geçilmedi.', 'warning');
            } else if (step.key === 'payment_process') {
                logMessage('Compensate', 'PaymentFailed eventi yayınlandı. Rezerve stok iadesi ve sipariş statüsü kontrol ediliyor...', 'warning');
                setTimeout(() => refreshDbSnapshot(true, false), 1500);
                setTimeout(() => refreshDbSnapshot(true, false), 4000);
            }
            await refreshDbSnapshot(false, false);
            fullPipelineStartTime = 0;
            return false;
        } catch (err) {
            logMessage('Pipeline', `İstek hatası: ${err}`, 'error');
            setStatus('bg-danger', 'İstek Hatası');
            fullPipelineStartTime = 0;
            return false;
        }
    }

    async function startFullPipeline() {
        if (isRunning) return;
        resetPipelineUI(false);
        isRunning = true;
        logMessage('Pipeline', `Otomatik akış başlatıldı: ${testOrderData.productName}`, 'info');

        while (currentStep < steps.length) {
            const success = await stepPipeline();
            if (!success) break;
            await new Promise(r => setTimeout(r, 700));
        }

        isRunning = false;
    }
</script>

<!-- SignalR -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const signalrConnection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/pipeline")
        .withAutomaticReconnect([0, 2000, 5000, 10000])
        .build();

    signalrConnection.on("ReceivePipelineEvent", (data) => {
        const sender = data.sender || 'Gerçek Site';
        const msg = data.message || '';
        const type = data.type || 'info';

        // Polly retry bildirimlerini simülasyon konsoluna yönlendir
        if (sender.toLowerCase().includes('polly') || msg.includes('Polly Retry')) {
            logDemoMessage('Polly', msg, type);
        } else {
            logLiveMessage(sender, msg, type);
        }
    });

    signalrConnection.start()
        .then(() => {
            document.getElementById('signalr-dot')?.classList.add('connected');
            logLiveMessage('SignalR', 'Bağlantı aktif. Gerçek site siparişleri dinleniyor.', 'success');
        })
        .catch(err => {
            const dot = document.getElementById('signalr-dot');
            if (dot) dot.className = 'pulse-dot bg-danger';
            logLiveMessage('SignalR', 'Bağlantı kurulamadı: ' + err, 'error');
        });
</script>
