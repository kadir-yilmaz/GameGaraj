@section Scripts {
    <script>
        function copyCouponCode(code, btn) {
            navigator.clipboard.writeText(code).then(function() {
                // Change icon to check
                const icon = btn.querySelector('i');
                icon.className = 'fa-solid fa-check text-success';
                
                // Show toast using our global notification helper
                if (window.showAppToast) {
                    window.showAppToast('success', 'Kupon kodu (' + code + ') kopyalandı!');
                }
                
                // Reset icon after 2 seconds
                setTimeout(function() {
                    icon.className = 'fa-regular fa-copy';
                }, 2000);
            }).catch(function(err) {
                console.error('Kopyalama başarısız: ', err);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            const sections = Array.from(document.querySelectorAll('[data-home-category-section]'));
            const pendingSections = [];
            let activeLoaders = 0;
            const maxConcurrentLoaders = 5;

            function loadNextSection() {
                if (pendingSections.length === 0) {
                    return;
                }

                while (activeLoaders < maxConcurrentLoaders && pendingSections.length > 0) {
                    const section = pendingSections.shift();
                    if (!section || section.dataset.loaded === 'true') {
                        continue;
                    }

                    const content = section.querySelector('[data-home-category-content]');
                    const url = section.dataset.loadUrl;

                    if (!content || !url) {
                        continue;
                    }

                    activeLoaders++;
                    section.dataset.loaded = 'true';

                    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error('Category products could not be loaded.');
                            }
                            return response.text();
                        })
                        .then(html => {
                            if (!html.includes('product-card')) {
                                section.style.display = 'none';
                            } else {
                                content.innerHTML = html;
                            }
                        })
                        .catch(() => {
                            content.innerHTML = '<div class="col-12"><div class="p-4 bg-light rounded-3 text-center text-muted">Urunler yuklenemedi.</div></div>';
                        })
                        .finally(() => {
                            activeLoaders--;
                            loadNextSection();
                        });
                }
            }

            if ('IntersectionObserver' in window) {
                const observer = new IntersectionObserver(function (entries) {
                    entries.forEach(entry => {
                        if (!entry.isIntersecting) {
                            return;
                        }

                        observer.unobserve(entry.target);
                        pendingSections.push(entry.target);
                        loadNextSection();
                    });
                }, { rootMargin: '250px 0px' });

                sections.forEach(section => observer.observe(section));
            } else {
                pendingSections.push(...sections);
                loadNextSection();
            }
            // Hero Carousel: indicator click + progress animation reset
            const heroEl = document.getElementById('heroCarousel');
            if (heroEl && typeof bootstrap !== 'undefined') {
                const heroCarousel = bootstrap.Carousel.getOrCreateInstance(heroEl, {
                    interval: 5500,
                    pause: 'hover',
                    ride: 'carousel'
                });
                const indicators = heroEl.querySelectorAll('.hero-indicators [data-bs-slide-to]');

                function restartIndicatorProgress(activeIdx) {
                    indicators.forEach((btn, idx) => {
                        const bar = btn.querySelector('.indicator-progress');
                        btn.classList.toggle('active', idx === activeIdx);
                        if (bar) {
                            bar.style.animation = 'none';
                            void bar.offsetWidth;
                            bar.style.animation = '';
                        }
                    });
                }

                indicators.forEach((btn, idx) => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        heroCarousel.to(idx);
                    });
                });

                heroEl.addEventListener('slide.bs.carousel', (e) => {
                    restartIndicatorProgress(e.to);
                });
            }

            const orderSuccessModalEl = document.getElementById('orderSuccessModal');
            if (orderSuccessModalEl && typeof bootstrap !== 'undefined') {
                bootstrap.Modal.getOrCreateInstance(orderSuccessModalEl).show();
            }
        });
    </script>

