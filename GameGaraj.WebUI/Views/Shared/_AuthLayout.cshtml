<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameGaraj</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        :root {
            --gg-primary: #ff6b00;
            --gg-primary-hover: #ea580c;
            --gg-bg-dark: #0b0f19;
            --gg-surface-dark: #111827;
            --gg-border: rgba(255, 255, 255, 0.08);
            --gg-text-main: #f8fafc;
            --gg-text-muted: #94a3b8;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background-color: var(--gg-bg-dark);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--gg-text-main);
            overflow-x: hidden;
        }

        .auth-viewport {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 24px 16px;
            position: relative;
            background: 
                radial-gradient(circle at 50% 10%, rgba(255, 107, 0, 0.12), transparent 45%),
                radial-gradient(circle at 80% 90%, rgba(59, 130, 246, 0.06), transparent 40%),
                #0b0f19;
        }

        .auth-brand-top {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            margin-bottom: 20px;
            transition: transform 0.2s ease;
        }

        .auth-brand-top:hover {
            transform: scale(1.03);
        }

        .auth-brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #ff6b00, #ea580c);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.1rem;
            box-shadow: 0 8px 20px rgba(255, 107, 0, 0.3);
        }

        .auth-brand-text {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #ffffff;
        }

        .auth-brand-text span {
            color: var(--gg-primary);
        }

        .auth-card-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .auth-back-btn {
            position: absolute;
            top: 24px;
            left: 24px;
            color: var(--gg-text-muted);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--gg-border);
            transition: all 0.2s ease;
        }

        .auth-back-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.16);
        }

        @@media (max-width: 576px) {
            .auth-back-btn {
                position: static;
                margin-bottom: 16px;
                align-self: flex-start;
            }
            .auth-viewport {
                padding: 16px;
                justify-content: flex-start;
            }
        }
    </style>
</head>
<body>
    <div class="auth-viewport">
        @if (!(ViewData["HideBackBtn"] is true))
        {
            <a href="/" class="auth-back-btn">
                <i class="fas fa-arrow-left"></i>
                <span>Mağazaya Dön</span>
            </a>
        }

        <a href="/" class="auth-brand-top">
            <div class="auth-brand-icon">
                <i class="fas fa-gamepad"></i>
            </div>
            <div class="auth-brand-text">Game<span>Garaj</span></div>
        </a>

        <div class="auth-card-wrapper">
            @RenderBody()
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Component.InvokeAsync("Notyf")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
