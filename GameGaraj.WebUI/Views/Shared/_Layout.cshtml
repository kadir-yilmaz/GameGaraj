@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var isAuthPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Auth", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameGaraj</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body style="min-height: 100vh; display: flex; flex-direction: column;">
    <header>
        <!-- Navbar -->
        @await Html.PartialAsync("_Navbar")
        
        <!-- Category Bar -->
        @await Component.InvokeAsync("CategoryMenu")
    </header>

    <div class="container-fluid px-0" style="flex: 1; margin-top: 0; background: @(isAuthPage ? "#2f3947" : "transparent");">
        <main role="main" class="@(isAuthPage ? string.Empty : "pb-3")">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="mt-auto pt-5 pb-4" style="background-color: #0d0d0d; color: #b0b0b0; border-top: 1px solid #222;">
        <div class="container text-center">
            <div class="row justify-content-center">
                <!-- Marka & Sosyal Medya -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white mb-3" style="font-weight: 700; letter-spacing: 1px;">GAMEGARAJ</h5>
                    <div class="mt-3">
                        <a href="#" class="text-white mx-2 social-icon" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white mx-2 social-icon" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white mx-2 social-icon" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-white mx-2 social-icon" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>

                <!-- Kurumsal Linkler -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white mb-3" style="font-weight: 600;">Kurumsal</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Biz Kimiz?</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Kariyer</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Gizlilik Politikası</a></li>
                    </ul>
                </div>

                <!-- İletişim Linkleri -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white mb-3" style="font-weight: 600;">İletişim</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary">İletişim Kanalları</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-secondary">Destek / SSS</a></li>
                        <li class="mb-2" style="font-size: 0.9em;"><i class="fas fa-envelope me-2"></i> info@gamegaraj.com</li>
                    </ul>
                </div>
            </div>

            <hr style="border-color: #333; margin: 20px 0;">

            <!-- Telif Hakkı & Versiyon -->
            <div class="row">
                <div class="col-12 text-center">
                    <p class="small mb-0">
                        &copy; 2026 GameGaraj. Tüm hakları saklıdır.
                        <span class="text-muted ms-2" style="font-size: 0.85em;">Version: @(Configuration["APP_VERSION"] ?? "test")</span>
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        window.isAuthenticated = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        @if (User.Identity?.IsAuthenticated == true)
        {
            var userId = User.FindFirst("sub")?.Value 
                         ?? User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value 
                         ?? string.Empty;
            <text>
            window.currentUserId = "@userId";
            (function () {
                if (!window.currentUserId) return;

                const discConn = new signalR.HubConnectionBuilder()
                    .withUrl('/hubs/discussion', {
                        skipNegotiation: false,
                        transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
                    })
                    .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                    .build();

                discConn.on("ReceiveMyQuestionAnswered", function (data) {
                    console.log("[SignalR Global] Sorum cevaplandı:", data);

                    // 1. Canlı Toast Bildirimi (Güncelleme mi Yeni Cevap mı)
                    if (window.showAppToast) {
                        if (data.isEdit) {
                            window.showAppToast('info', `💬 Yanıt Güncellendi: "${data.productName || 'Ürün'}" sorunuza verilen yanıt satıcı tarafından güncellendi.`);
                        } else {
                            window.showAppToast('success', `💬 Sorunuz Cevaplandı: "${data.productName || 'Ürün'}" için yetkili satıcı yanıt verdi!`);
                        }
                    }

                    // 2. Sadece yeni cevapsa rozet (badge) sayısını artır
                    if (!data.isEdit) {
                        const $profileBadges = $('#nav-profile-badge, #nav-mobile-profile-badge');
                        $profileBadges.each(function () {
                            let count = parseInt($(this).text() || '0') + 1;
                            $(this).text(count).removeClass('d-none');
                        });

                        const $badges = $('#nav-user-discussion-badge, #nav-mobile-user-discussion-badge');
                        $badges.each(function () {
                            let count = parseInt($(this).text() || '0') + 1;
                            $(this).text(count).removeClass('d-none');
                        });
                    }
                });

                discConn.start()
                    .then(function () {
                        discConn.invoke("JoinUserGroup", window.currentUserId).catch(console.error);
                    })
                    .catch(function (err) {
                        console.warn("[SignalR Global] Discussion Hub bağlantı hatası:", err);
                    });
            })();
            </text>
        }
    </script>
    
    @await Component.InvokeAsync("Notyf")

    @if (TempData["BasketNotification"] != null)
    {
        <script>
            $(function() {
                window.showAppToast && window.showAppToast('success', 'Ürün sepete eklendi!');
            });
        </script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
