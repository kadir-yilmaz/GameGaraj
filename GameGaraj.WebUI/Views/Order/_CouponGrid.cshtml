@model List<GameGaraj.WebUI.Models.Campaigns.CouponViewModel>
@{
    var emptyText = ViewData["EmptyText"] as string ?? "Kupon bulunmuyor.";
    var isPersonal = ViewData["IsPersonalTab"] is bool b && b;
}

@if (!Model.Any())
{
    <div class="mc-empty-card">
        <h5 class="mc-empty-title mb-1">@emptyText</h5>
        <p class="mc-empty-desc mb-0">Yeni kampanyalar yayınlandığında kuponlarınız burada listelenecektir.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var coupon in Model)
        {
            var isExpired = coupon.ExpiryDate.HasValue && coupon.ExpiryDate.Value < DateTime.Now;
            var isDisabled = coupon.IsUsed || isExpired;
            var statusText = coupon.IsUsed ? "Kullanıldı" : (isExpired ? "Süresi Doldu" : "Kullanılabilir");
            var statusClass = coupon.IsUsed ? "mc-badge-used" : (isExpired ? "mc-badge-expired" : "mc-badge-active");
            decimal minPurchase = coupon.MinPurchaseAmount ?? 0m;

            <div class="col-lg-6">
                <div class="mc-ticket @(isPersonal ? "is-personal" : "") @(isDisabled ? "is-disabled" : "")">
                    <div class="mc-ticket-left">
                        @if (coupon.DiscountType == "Percentage")
                        {
                            <div class="mc-ticket-val">%@((coupon.DiscountRate ?? 0m).ToString("0.##"))</div>
                            <div class="mc-ticket-sub">İndirim</div>
                            @if (coupon.MaxDiscountAmount > 0)
                            {
                                <div class="mc-ticket-max">Maks. @coupon.MaxDiscountAmount.Value.ToString("N0") TL</div>
                            }
                        }
                        else if (coupon.DiscountType == "FixedAmount")
                        {
                            <div class="mc-ticket-val">@((coupon.Amount ?? 0m).ToString("N0")) TL</div>
                            <div class="mc-ticket-sub">İndirim</div>
                        }
                        else
                        {
                            <div class="mc-ticket-val" style="font-size: 1.15rem;">Ücretsiz</div>
                            <div class="mc-ticket-sub">Kargo</div>
                        }
                    </div>

                    <div class="mc-ticket-body">
                        <div>
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                <span class="@statusClass">@statusText</span>
                                <span class="text-muted" style="font-size: 0.76rem;">
                                    @(coupon.ExpiryDate.HasValue ? $"Son: {coupon.ExpiryDate.Value:dd.MM.yyyy}" : "Süresiz")
                                </span>
                            </div>
                            <div class="text-muted" style="font-size: 0.82rem;">
                                @if (minPurchase > 0)
                                {
                                    <span>Minimum sepet tutarı: <strong class="text-dark">@minPurchase.ToString("N0") TL</strong></span>
                                }
                                else
                                {
                                    <span>Alt limitsiz tüm sepetlerde geçerli</span>
                                }
                            </div>
                        </div>

                        <div class="mc-code-row">
                            <span class="mc-code-pill @(isDisabled ? "text-decoration-line-through text-muted" : "")">@coupon.Code</span>
                            @if (!isDisabled)
                            {
                                <button type="button" class="mc-copy-btn" onclick="copyCouponCode('@coupon.Code', this)">Kopyala</button>
                                <form asp-controller="Basket" asp-action="ApplyCoupon" method="post" class="m-0">
                                    <input type="hidden" name="couponCode" value="@coupon.Code" />
                                    <button type="submit" class="mc-use-btn">Sepette Kullan</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
