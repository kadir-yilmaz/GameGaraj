@model List<GameGaraj.WebUI.Models.Campaigns.CouponViewModel>
@using GameGaraj.WebUI.Models.Campaigns
@{
    ViewData["Title"] = "Kuponlarim";
    var publicCoupons = ViewBag.PublicCoupons as List<CouponViewModel> ?? new();
    var privateCoupons = Model ?? new();
}

<style>
    .coupon-card {
        background: linear-gradient(135deg, #1e2235 0%, #151824 100%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        position: relative;
        overflow: hidden;
        color: #fff;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .coupon-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    }

    .coupon-card::before,
    .coupon-card::after {
        content: '';
        position: absolute;
        width: 20px;
        height: 20px;
        background-color: #0f111a;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
    }

    .coupon-card::before {
        left: -10px;
    }

    .coupon-card::after {
        right: -10px;
    }

    .coupon-divider {
        border-left: 2px dashed rgba(255, 255, 255, 0.15);
        height: 80%;
        margin-left: 10px;
        margin-right: 20px;
    }

    .coupon-code-badge {
        font-family: 'Courier New', Courier, monospace;
        letter-spacing: 1px;
        font-size: 1.1rem;
        background-color: rgba(255, 255, 255, 0.07);
        border: 1px dashed rgba(255, 255, 255, 0.3);
        padding: 6px 12px;
        border-radius: 6px;
        color: #f1c40f;
    }

    .btn-copy-coupon {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.6);
        transition: color 0.2s;
    }

    .btn-copy-coupon:hover {
        color: #fff;
    }

    .coupon-tabs .nav-link {
        color: rgba(255, 255, 255, 0.72);
        border-color: transparent;
    }

    .coupon-tabs .nav-link.active {
        color: #111;
        background-color: #f1c40f;
        border-color: #f1c40f;
        font-weight: 700;
    }
</style>

<div class="container py-5" style="background-color: #0f111a; min-height: 80vh; border-radius: 12px; color: #fff;">
    <div class="d-flex align-items-center mb-5">
        <i class="fas fa-ticket-alt text-warning fa-2x me-3"></i>
        <h2 class="mb-0 fw-bold">Kuponlarim</h2>
    </div>

    @if (!publicCoupons.Any() && !privateCoupons.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-ticket-alt text-muted fa-4x mb-4 opacity-30"></i>
            <h4 class="text-muted">Aktif kuponunuz bulunmamaktadir.</h4>
            <p class="text-muted small">Siparis vererek ve sadakat hedeflerini tamamlayarak yeni kuponlar kazanabilirsiniz.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning mt-3 px-4 py-2 fw-bold text-dark">Alisverise Basla</a>
        </div>
    }
    else
    {
        <ul class="nav nav-tabs coupon-tabs border-secondary mb-4" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="public-coupons-tab" data-bs-toggle="tab" data-bs-target="#public-coupons" type="button" role="tab">
                    Herkese Acik <span class="badge bg-secondary ms-1">@publicCoupons.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="private-coupons-tab" data-bs-toggle="tab" data-bs-target="#private-coupons" type="button" role="tab">
                    Bana Ozel <span class="badge bg-secondary ms-1">@privateCoupons.Count</span>
                </button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="public-coupons" role="tabpanel" aria-labelledby="public-coupons-tab">
                @{
                    ViewData["EmptyText"] = "Herkese acik kupon bulunmamaktadir.";
                }
                <partial name="_CouponGrid" model="publicCoupons" />
            </div>
            <div class="tab-pane fade" id="private-coupons" role="tabpanel" aria-labelledby="private-coupons-tab">
                @{
                    ViewData["EmptyText"] = "Size ozel kupon bulunmamaktadir.";
                }
                <partial name="_CouponGrid" model="privateCoupons" />
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyCouponCode(code, id) {
            navigator.clipboard.writeText(code).then(() => {
                const icon = document.getElementById('icon-' + id);
                icon.className = 'fas fa-check text-success fa-lg';

                if (typeof window.showNotification === 'function') {
                    window.showNotification('Kupon kodu kopyalandi.', 'success');
                } else {
                    alert('Kupon kodu kopyalandi: ' + code);
                }

                setTimeout(() => {
                    icon.className = 'far fa-copy fa-lg';
                }, 2000);
            });
        }
    </script>
}
