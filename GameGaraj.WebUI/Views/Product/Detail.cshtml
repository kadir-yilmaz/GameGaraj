@model GameGaraj.WebUI.Models.Products.ProductViewModel
@{
    ViewData["Title"] = Model.Name;
    var displayImageUrls = Model.DisplayImageUrls;
    var reviewSummary = ViewBag.Reviews as GameGaraj.WebUI.Models.Reviews.ReviewListViewModel ?? new GameGaraj.WebUI.Models.Reviews.ReviewListViewModel();
    var questionSummary = ViewBag.Questions as GameGaraj.WebUI.Models.Discussion.QuestionListViewModel ?? new GameGaraj.WebUI.Models.Discussion.QuestionListViewModel();
}

@section Styles {
    <link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />
}

<!-- Breadcrumb -->
<div class="breadcrumb-section">
    <div class="container">
        <a asp-controller="Home" asp-action="Index">Ana Sayfa</a>
        <span class="separator">&gt;</span>
        @if (!string.IsNullOrEmpty(Model.CategoryName))
        {
            <a href="@GameGaraj.WebUI.Extensions.SlugHelper.BuildCategoryUrl(ViewBag.CategorySlug as string, Model.CategoryId)">@Model.CategoryName</a>
            <span class="separator">&gt;</span>
        }
        <span class="text-muted">@Model.Name</span>
    </div>
</div>

<div class="product-page">
    <div class="container">
        <!-- Main Product Card (Gallery + Info + Buy Box) -->
        <div class="product-main">
            <div class="row">
                <!-- Gallery Partial (Left Column & Modal) -->
                <partial name="_ProductGalleryPartial" model="Model" />

                <!-- Info Partial (Middle Column & Right Sidebar) -->
                <partial name="_ProductInfoPartial" model="Model" />
            </div>
        </div>

        <!-- Tabs Section -->
        <div class="tabs-section">
            <!-- Tab Navigation -->
            <div class="tab-nav">
                <button class="tab-btn active" onclick="openTab(event, 'description')">Ürün Açıklaması</button>
                <button class="tab-btn" onclick="openTab(event, 'specs')">Teknik Özellikler</button>
                <button class="tab-btn" onclick="openTab(event, 'reviews')">
                    Değerlendirmeler <span style="background: #ff6000; color: white; padding: 0.1rem 0.4rem; border-radius: 10px; font-size: 0.7rem; margin-left: 0.25rem;">@reviewSummary.TotalCount</span>
                </button>
                <button class="tab-btn" onclick="openTab(event, 'qa')">
                    Soru &amp; Cevap <span style="background: #0d6efd; color: white; padding: 0.1rem 0.4rem; border-radius: 10px; font-size: 0.7rem; margin-left: 0.25rem;">@questionSummary.TotalCount</span>
                </button>
            </div>

            <!-- Tab Content -->
            <div class="tab-content">
                <!-- Description Tab -->
                <div id="description" class="tab-pane active">
                    <h2 class="specs-header">Ürün Açıklaması</h2>
                    <p style="font-size: 0.95rem; line-height: 1.8; color: #333;">
                        <strong>@Model.Name</strong>
                    </p>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p style="font-size: 0.95rem; line-height: 1.8; color: #666;">
                            @Model.Description
                        </p>
                    }
                </div>

                <!-- Specs Tab -->
                <div id="specs" class="tab-pane">
                    <partial name="_ProductSpecsPartial" model="Model" />
                </div>

                <!-- Reviews Tab -->
                <div id="reviews" class="tab-pane">
                    <partial name="_ProductReviewsPartial" model="Model" />
                </div>

                <!-- Q&A Tab -->
                <div id="qa" class="tab-pane">
                    <partial name="_ProductQuestionsPartial" model="Model" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentImageIndex = 0;
        const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(displayImageUrls));

        function applyGalleryImageOrientation(imgElement) {
            if (!imgElement) return;
            const isPortrait = imgElement.naturalHeight > imgElement.naturalWidth * 1.08;
            imgElement.classList.remove('is-portrait', 'is-landscape');
            imgElement.classList.add(isPortrait ? 'is-portrait' : 'is-landscape');
        }

        function selectImage(index, src) {
            currentImageIndex = index;
            const mainImg = document.getElementById('mainImage');
            if (mainImg) mainImg.src = src;

            document.querySelectorAll('.thumbnail-item').forEach((item, i) => {
                item.classList.toggle('active', i === index);
            });
        }

        function prevImage() {
            if (images.length === 0) return;
            currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
            selectImage(currentImageIndex, images[currentImageIndex]);
        }

        function nextImage() {
            if (images.length === 0) return;
            currentImageIndex = (currentImageIndex + 1) % images.length;
            selectImage(currentImageIndex, images[currentImageIndex]);
        }

        // Tab functionality
        function openTab(evt, tabName) {
            document.querySelectorAll('.tab-pane').forEach(pane => {
                pane.classList.remove('active');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            const targetPane = document.getElementById(tabName);
            if (targetPane) targetPane.classList.add('active');
            if (evt && evt.currentTarget) evt.currentTarget.classList.add('active');
        }

        function openTabByName(tabName) {
            const btn = document.querySelector(`.tab-btn[onclick*="${tabName}"]`);
            if (btn) btn.click();
        }

        // Share functionality
        function shareProduct() {
            if (navigator.share) {
                navigator.share({
                    title: '@Model.Name',
                    url: window.location.href
                });
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert('Link kopyalandı!');
            }
        }

        // Modal Gallery functionality
        let modal;
        document.addEventListener("DOMContentLoaded", function () {
            let modalEl = document.getElementById('imageGalleryModal');
            const modalMainImage = document.getElementById('modalMainImage');
            if (modalEl) {
                modal = new bootstrap.Modal(modalEl);
                modalEl.addEventListener('hidden.bs.modal', function () {
                    selectImage(currentImageIndex, images[currentImageIndex]);
                });
            }

            if (modalMainImage) {
                if (modalMainImage.complete) {
                    applyGalleryImageOrientation(modalMainImage);
                } else {
                    modalMainImage.addEventListener('load', function () {
                        applyGalleryImageOrientation(modalMainImage);
                    });
                }
            }
        });

        function openGalleryModal() {
            if (modal) {
                selectModalImage(currentImageIndex, images[currentImageIndex]);
                modal.show();
            }
        }

        function selectModalImage(index, src) {
            currentImageIndex = index;
            const modalMainImage = document.getElementById('modalMainImage');
            if (modalMainImage) {
                modalMainImage.src = src;
                if (modalMainImage.complete) {
                    applyGalleryImageOrientation(modalMainImage);
                } else {
                    modalMainImage.onload = function () {
                        applyGalleryImageOrientation(modalMainImage);
                    };
                }
            }

            document.querySelectorAll('.modal-thumb-item').forEach((item, i) => {
                item.classList.toggle('active', i === index);
            });
        }

        function prevModalImage() {
            if (images.length === 0) return;
            currentImageIndex = (currentImageIndex - 1 + images.length) % images.length;
            selectModalImage(currentImageIndex, images[currentImageIndex]);
        }

        function nextModalImage() {
            if (images.length === 0) return;
            currentImageIndex = (currentImageIndex + 1) % images.length;
            selectModalImage(currentImageIndex, images[currentImageIndex]);
        }

        // Keyboard arrow navigation
        document.addEventListener('keydown', function (e) {
            if (images && images.length > 1) {
                if (e.key === 'ArrowLeft') {
                    const modalEl = document.getElementById('imageGalleryModal');
                    if (modalEl && modalEl.classList.contains('show')) {
                        prevModalImage();
                    } else {
                        prevImage();
                    }
                } else if (e.key === 'ArrowRight') {
                    const modalEl = document.getElementById('imageGalleryModal');
                    if (modalEl && modalEl.classList.contains('show')) {
                        nextModalImage();
                    } else {
                        nextImage();
                    }
                }
            }
        });

        // Ask Question button handler
        $(document).on('click', '.js-ask-question-btn', function (e) {
            e.preventDefault();
            if (!window.isAuthenticated) {
                window.setPendingToast('warning', 'Soru sormak için lütfen giriş yapın.');
                var returnUrl = window.location.pathname + window.location.search + '#qa';
                window.location.href = '/Auth/SignIn?returnUrl=' + encodeURIComponent(returnUrl);
                return;
            }
            const $formContainer = $('#askQuestionFormContainer');
            if ($formContainer.length) {
                $formContainer.slideToggle(250, function () {
                    if ($formContainer.is(':visible')) {
                        $('#askQuestionTextarea').focus();
                    }
                });
            }
        });

        // Character counter for ask question textarea
        $(document).on('input', '#askQuestionTextarea', function () {
            const length = $(this).val().length;
            $('#askQuestionCharCounter').text(length + ' / 500');
        });

        // If URL has #qa hash, activate Q&A tab on load
        if (window.location.hash === '#qa') {
            const qaBtn = document.querySelector('.tab-btn[onclick*="qa"]');
            if (qaBtn) {
                qaBtn.click();
            }
        }

        // Apply Question Template Chip
        function applyQuestionTemplate(text) {
            const textarea = document.getElementById('askQuestionTextarea');
            if (textarea) {
                textarea.value = text;
                $('#askQuestionCharCounter').text(text.length + ' / 500');
                textarea.focus();
            }
        }

        // Live Filter for Questions
        function filterQuestions() {
            const input = document.getElementById('qaSearchInput');
            if (!input) return;
            const filter = input.value.toLowerCase().trim();
            const items = document.querySelectorAll('.qa-question-entry');

            items.forEach(item => {
                const text = item.getAttribute('data-text') || '';
                if (text.includes(filter)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Answer Vote Handler (Helpful / Dislike)
        function handleAnswerVote(btn) {
            const $btn = $(btn);
            const answerId = $btn.data('answer-id');
            const isHelpful = $btn.data('is-helpful') === true || $btn.data('is-helpful') === 'true';

            if (!window.isAuthenticated) {
                window.setPendingToast('warning', 'Oy kullanmak için lütfen giriş yapın.');
                var returnUrl = window.location.pathname + window.location.search + '#qa';
                window.location.href = '/Auth/SignIn?returnUrl=' + encodeURIComponent(returnUrl);
                return;
            }

            const token = $('input[name="__RequestVerificationToken"]').first().val();

            $.ajax({
                url: '/Product/VoteAnswer',
                type: 'POST',
                data: {
                    answerId: answerId,
                    isHelpful: isHelpful,
                    __RequestVerificationToken: token
                },
                success: function (res) {
                    if (res && res.succeeded) {
                        const $parentBox = $btn.closest('.qa-seller-answer-box');
                        const $helpfulBtn = $parentBox.find('.qa-vote-helpful');
                        const $dislikeBtn = $parentBox.find('.qa-vote-dislike');

                        // Sayaçları güncelle
                        $helpfulBtn.find('.qa-helpful-count').text(res.helpfulCount);
                        $dislikeBtn.find('.qa-dislike-count').text(res.dislikeCount);

                        // Buton sınıfları ve ikonları güncelle
                        if (res.userVote === 'helpful') {
                            $helpfulBtn.addClass('voted-helpful').find('i').removeClass('far').addClass('fas');
                            $dislikeBtn.removeClass('voted-dislike').find('i').removeClass('fas').addClass('far');
                        } else if (res.userVote === 'dislike') {
                            $dislikeBtn.addClass('voted-dislike').find('i').removeClass('far').addClass('fas');
                            $helpfulBtn.removeClass('voted-helpful').find('i').removeClass('fas').addClass('far');
                        } else {
                            $helpfulBtn.removeClass('voted-helpful').find('i').removeClass('fas').addClass('far');
                            $dislikeBtn.removeClass('voted-dislike').find('i').removeClass('fas').addClass('far');
                        }

                        if (window.showAppToast && res.message) {
                            window.showAppToast('success', res.message);
                        }
                    } else if (res && res.requireAuth) {
                        window.setPendingToast('warning', res.message || 'Giriş yapmanız gerekmektedir.');
                        var returnUrl = window.location.pathname + window.location.search + '#qa';
                        window.location.href = '/Auth/SignIn?returnUrl=' + encodeURIComponent(returnUrl);
                    } else {
                        if (window.showAppToast) {
                            window.showAppToast('error', res.message || 'Oylama gerçekleştirilemedi.');
                        }
                    }
                },
                error: function () {
                    if (window.showAppToast) {
                        window.showAppToast('error', 'Oylama yapılırken bir bağlantı hatası oluştu.');
                    }
                }
            });
        }

        // Form submit AJAX (No Full Page Reload)
        $(document).on('submit', '#askQuestionForm', function (e) {
            e.preventDefault();

            const $form = $(this);
            const $textarea = $('#askQuestionTextarea');
            const text = ($textarea.val() || '').trim();

            if (text.length < 10) {
                if (window.showAppToast) {
                    window.showAppToast('warning', 'Sorunuz en az 10 karakter olmalıdır.');
                }
                $textarea.focus();
                return;
            }

            const $btn = $('#btnSubmitQuestion');
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Gönderiliyor...');

            $.ajax({
                url: '/Product/CreateQuestionAjax',
                type: 'POST',
                data: $form.serialize(),
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Soruyu Gönder');

                    if (res && res.succeeded) {
                        if (window.showAppToast) {
                            window.showAppToast('success', res.message || 'Sorunuz başarıyla iletildi!');
                        }

                        $textarea.val('');
                        $('#askQuestionCharCounter').text('0 / 500');
                        $('#askQuestionFormContainer').slideUp(250);

                        $('.qa-empty-state').remove();

                        if ($('#qaQuestionsList').length === 0) {
                            $('.qa-tab-container').append('<div class="qa-list" id="qaQuestionsList"></div>');
                        }

                        if (res.id && $(`.qa-question-entry[data-question-id="${res.id}"]`).length === 0) {
                            const initial = (res.userName || 'K').substring(0, 1).toUpperCase();
                            const nowStr = new Date().toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                            const html = `
                                <div class="qa-card-item qa-question-entry" data-question-id="${res.id}" data-text="${escapeHtml(res.questionText || '').toLowerCase()}" style="animation: qaFadeIn 0.4s ease;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="qa-avatar">${initial}</div>
                                            <div>
                                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(res.userName)}</span>
                                                <div class="text-muted" style="font-size: 0.75rem;">
                                                    <i class="far fa-calendar-alt me-1"></i>${nowStr}
                                                </div>
                                            </div>
                                        </div>
                                        <span class="qa-status-badge qa-status-pending">
                                            <i class="fas fa-clock me-1"></i>Beklemede
                                        </span>
                                    </div>
                                    <p class="text-dark mb-0 fw-medium" style="font-size: 0.95rem; line-height: 1.55;">
                                        ${escapeHtml(res.questionText)}
                                    </p>
                                    <div class="alert alert-warning border-0 d-flex align-items-center gap-2 py-2 px-3 mt-2 mb-0 rounded-3" style="background: #fffbeb; font-size: 0.85rem;">
                                        <i class="fas fa-clock-rotate-left text-warning"></i>
                                        <div>
                                            <strong class="text-dark">Beklemede:</strong> <span class="text-muted">Sorunuz satıcıya iletildi. Yanıtlandığında burada herkese açık olarak yayınlanacaktır.</span>
                                        </div>
                                    </div>
                                </div>`;

                            $('#qaQuestionsList').prepend(html);
                            updateQaTabCounters(1);
                        }
                    } else if (res && res.requireAuth) {
                        window.setPendingToast('warning', res.message || 'Soru sormak için lütfen giriş yapın.');
                        var returnUrl = window.location.pathname + window.location.search + '#qa';
                        window.location.href = '/Auth/SignIn?returnUrl=' + encodeURIComponent(returnUrl);
                    } else {
                        if (window.showAppToast) {
                            window.showAppToast('error', res.message || 'Soru gönderilemedi.');
                        }
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Soruyu Gönder');
                    if (window.showAppToast) {
                        window.showAppToast('error', 'Bir bağlantı hatası oluştu.');
                    }
                }
            });
        });

        // Pagination / Load More Questions
        let currentQaPage = 1;
        function loadMoreQuestions() {
            const $btn = $('#btnLoadMoreQuestions');
            const productId = "@Model.Id";
            if (!productId) return;

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Yükleniyor...');

            $.ajax({
                url: `/Product/GetMoreQuestions?productId=${encodeURIComponent(productId)}&page=${currentQaPage}&pageSize=10`,
                type: 'GET',
                success: function (res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-chevron-down me-1"></i> Daha Fazla Soru Göster');

                    if (res && res.items && res.items.length > 0) {
                        currentQaPage++;
                        res.items.forEach(function (q) {
                            if ($(`.qa-question-entry[data-question-id="${q.id}"]`).length > 0) return;

                            const name = q.formattedUserName || q.userName || 'Kullanıcı';
                            const initial = name.substring(0, 1).toUpperCase();
                            const dateStr = new Date(q.createdAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                            let answerHtml = '';
                            let badgeHtml = '<span class="qa-status-badge qa-status-pending"><i class="fas fa-clock me-1"></i>Beklemede</span>';

                            if (q.answer) {
                                badgeHtml = '<span class="qa-status-badge qa-status-answered"><i class="fas fa-check-double me-1"></i>Cevaplandı</span>';
                                const ansDateStr = new Date(q.answer.createdAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                                const ansResponder = q.answer.responderName || 'GameGaraj';
                                const helpfulCount = q.answer.helpfulCount || 0;
                                const dislikeCount = q.answer.dislikeCount || 0;
                                const isHelpfulActive = q.answer.userVote === 'helpful';
                                const isDislikeActive = q.answer.userVote === 'dislike';

                                answerHtml = `
                                    <div class="qa-seller-answer-box">
                                        <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="qa-seller-badge">
                                                    <i class="fas fa-check-circle"></i> SATICI YANITI
                                                </span>
                                                <span class="small fw-bold text-dark">${escapeHtml(ansResponder)}</span>
                                            </div>
                                            <small class="text-muted" style="font-size: 0.75rem;">
                                                <i class="far fa-clock me-1"></i>${ansDateStr}
                                            </small>
                                        </div>
                                        <p class="mb-2 text-dark" style="font-size: 0.92rem; line-height: 1.6;">
                                            ${escapeHtml(q.answer.answerText)}
                                        </p>
                                        <div class="d-flex align-items-center justify-content-end gap-2 mt-2 pt-2 border-top border-light-subtle flex-wrap">
                                            <span class="text-muted small" style="font-size: 0.8rem;">Bu yanıt yardımcı oldu mu?</span>
                                            <button type="button" 
                                                    class="qa-vote-btn qa-vote-helpful ${isHelpfulActive ? 'voted-helpful' : ''}" 
                                                    data-answer-id="${q.answer.id}" 
                                                    data-is-helpful="true" 
                                                    onclick="handleAnswerVote(this)"
                                                    title="Faydalı">
                                                <i class="${isHelpfulActive ? 'fas' : 'far'} fa-thumbs-up"></i>
                                                <span class="badge rounded-pill qa-helpful-count">${helpfulCount}</span>
                                            </button>
                                            <button type="button" 
                                                    class="qa-vote-btn qa-vote-dislike ${isDislikeActive ? 'voted-dislike' : ''}" 
                                                    data-answer-id="${q.answer.id}" 
                                                    data-is-helpful="false" 
                                                    onclick="handleAnswerVote(this)"
                                                    title="Faydalı Değil">
                                                <i class="${isDislikeActive ? 'fas' : 'far'} fa-thumbs-down"></i>
                                                <span class="badge rounded-pill qa-dislike-count">${dislikeCount}</span>
                                            </button>
                                        </div>
                                    </div>`;
                            } else {
                                answerHtml = `
                                    <div class="alert alert-warning border-0 d-flex align-items-center gap-2 py-2 px-3 mt-2 mb-0 rounded-3" style="background: #fffbeb; font-size: 0.85rem;">
                                        <i class="fas fa-clock-rotate-left text-warning"></i>
                                        <div>
                                            <strong class="text-dark">Beklemede:</strong> <span class="text-muted">Sorunuz satıcıya iletildi. Yanıtlandığında burada herkese açık olarak yayınlanacaktır.</span>
                                        </div>
                                    </div>`;
                            }

                            const cardHtml = `
                                <div class="qa-card-item qa-question-entry" data-question-id="${q.id}" data-text="${(q.questionText || '').toLowerCase()}">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="qa-avatar">${initial}</div>
                                            <div>
                                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(name)}</span>
                                                <div class="text-muted" style="font-size: 0.75rem;">
                                                    <i class="far fa-calendar-alt me-1"></i>${dateStr}
                                                </div>
                                            </div>
                                        </div>
                                        ${badgeHtml}
                                    </div>
                                    <p class="text-dark mb-0 fw-medium" style="font-size: 0.95rem; line-height: 1.55;">
                                        ${escapeHtml(q.questionText)}
                                    </p>
                                    ${answerHtml}
                                </div>`;

                            $('#qaQuestionsList').append(cardHtml);
                        });

                        const loadedCount = $('.qa-question-entry').length;
                        const remaining = Math.max(0, (res.totalCount || 0) - loadedCount);
                        if (remaining <= 0) {
                            $('#qaLoadMoreContainer').fadeOut();
                        } else {
                            $('#qaRemainingCount').text(remaining);
                        }
                    } else {
                        $('#qaLoadMoreContainer').fadeOut();
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).html('<i class="fas fa-chevron-down me-1"></i> Daha Fazla Soru Göster');
                    if (window.showAppToast) {
                        window.showAppToast('error', 'Daha fazla soru yüklenirken bir sorun oluştu.');
                    }
                }
            });
        }
    </script>

    <!-- SignalR Real-Time Client for Product Discussion -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        function updateQaTabCounters(delta) {
            $('.tab-btn[onclick*="qa"] .badge, .qa-hero-header .qa-badge-count').each(function () {
                let current = parseInt($(this).text() || '0') + delta;
                $(this).text(Math.max(0, current));
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        (function () {
            const productId = "@Model.Id";
            if (!productId) return;

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/discussion', {
                    skipNegotiation: false,
                    transport: signalR.HttpTransportType.WebSockets | signalR.HttpTransportType.LongPolling
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            // 1. Yeni Soru Canlı Geldiğinde
            connection.on("ReceiveNewQuestion", function (q) {
                console.log("[SignalR Detail] New Question received:", q);

                $('.qa-empty-state').remove();

                if ($('#qaQuestionsList').length === 0) {
                    $('.qa-tab-container').append('<div class="qa-list" id="qaQuestionsList"></div>');
                }

                if ($(`.qa-question-entry[data-question-id="${q.id}"]`).length > 0) return;

                const name = q.formattedUserName || q.userName || 'Kullanıcı';
                const initial = name.substring(0, 1).toUpperCase();
                const dateStr = new Date(q.createdAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });

                const html = `
                    <div class="qa-card-item qa-question-entry" data-question-id="${q.id}" data-text="${(q.questionText || '').toLowerCase()}" style="animation: qaFadeIn 0.4s ease;">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="qa-avatar">${initial}</div>
                                <div>
                                    <span class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(name)}</span>
                                    <div class="text-muted" style="font-size: 0.75rem;">
                                        <i class="far fa-calendar-alt me-1"></i>${dateStr}
                                    </div>
                                </div>
                            </div>
                            <span class="qa-status-badge qa-status-pending">
                                <i class="fas fa-clock me-1"></i>Beklemede
                            </span>
                        </div>
                        <p class="text-dark mb-0 fw-medium" style="font-size: 0.95rem; line-height: 1.55;">
                            ${escapeHtml(q.questionText)}
                        </p>
                        <div class="alert alert-warning border-0 d-flex align-items-center gap-2 py-2 px-3 mt-2 mb-0 rounded-3" style="background: #fffbeb; font-size: 0.85rem;">
                            <i class="fas fa-clock-rotate-left text-warning"></i>
                            <div>
                                <strong class="text-dark">Beklemede:</strong> <span class="text-muted">Sorunuz satıcıya iletildi. Yanıtlandığında burada herkese açık olarak yayınlanacaktır.</span>
                            </div>
                        </div>
                    </div>`;

                $('#qaQuestionsList').prepend(html);
                updateQaTabCounters(1);
            });

            // 2. Soru Cevaplandığında / Yanıt Güncellendiğinde
            connection.on("ReceiveQuestionAnswered", function (a) {
                console.log("[SignalR Detail] Question Answered:", a);
                const $qCard = $(`.qa-question-entry[data-question-id="${a.questionId}"]`);
                if ($qCard.length) {
                    $qCard.find('.qa-status-badge').replaceWith(`
                        <span class="qa-status-badge qa-status-answered">
                            <i class="fas fa-check-double me-1"></i>Cevaplandı
                        </span>`);

                    $qCard.find('.alert-warning').remove();

                    const dateStr = new Date(a.createdAt).toLocaleString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    const responder = a.responderName || 'GameGaraj';

                    const $existingBox = $qCard.find('.qa-seller-answer-box');
                    if ($existingBox.length > 0) {
                        $existingBox.find('p').first().text(a.answerText);
                        $existingBox.find('small.text-muted').html('<i class="far fa-clock me-1"></i>' + dateStr + (a.isEdit ? ' <span class="badge bg-secondary-subtle text-secondary small">(Güncellendi)</span>' : ''));
                        $existingBox.css('background-color', '#eff6ff');
                        setTimeout(function () { $existingBox.css('background-color', '#fff9f5'); }, 1200);
                    } else {
                        const answerId = a.answerId || a.id || '';
                        const answerBox = `
                            <div class="qa-seller-answer-box" style="animation: qaFadeIn 0.4s ease;">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="qa-seller-badge">
                                            <i class="fas fa-check-circle"></i> SATICI YANITI
                                        </span>
                                        <span class="small fw-bold text-dark">${escapeHtml(responder)}</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;">
                                        <i class="far fa-clock me-1"></i>${dateStr}
                                    </small>
                                </div>
                                <p class="mb-2 text-dark" style="font-size: 0.92rem; line-height: 1.6;">
                                    ${escapeHtml(a.answerText)}
                                </p>
                                <div class="d-flex align-items-center justify-content-end gap-2 mt-2 pt-2 border-top border-light-subtle flex-wrap">
                                    <span class="text-muted small" style="font-size: 0.8rem;">Bu yanıt yardımcı oldu mu?</span>
                                    <button type="button" 
                                            class="qa-vote-btn qa-vote-helpful" 
                                            data-answer-id="${answerId}" 
                                            data-is-helpful="true" 
                                            onclick="handleAnswerVote(this)"
                                            title="Faydalı">
                                        <i class="far fa-thumbs-up"></i>
                                        <span class="badge rounded-pill qa-helpful-count">0</span>
                                    </button>
                                    <button type="button" 
                                            class="qa-vote-btn qa-vote-dislike" 
                                            data-answer-id="${answerId}" 
                                            data-is-helpful="false" 
                                            onclick="handleAnswerVote(this)"
                                            title="Faydalı Değil">
                                        <i class="far fa-thumbs-down"></i>
                                        <span class="badge rounded-pill qa-dislike-count">0</span>
                                    </button>
                                </div>
                            </div>`;

                        $qCard.append(answerBox);
                    }
                }
            });

            // 3. Soru Silindiğinde
            connection.on("ReceiveQuestionDeleted", function (d) {
                console.log("[SignalR Detail] Question Deleted:", d);
                const $qCard = $(`.qa-question-entry[data-question-id="${d.questionId}"]`);
                if ($qCard.length) {
                    $qCard.fadeOut(300, function () {
                        $(this).remove();
                        updateQaTabCounters(-1);
                    });
                }
            });

            connection.start()
                .then(function () {
                    console.log("[SignalR Detail] Connected to Discussion Hub for product", productId);
                    connection.invoke("JoinProductGroup", productId).catch(console.error);
                })
                .catch(function (err) {
                    console.warn("[SignalR Detail] Discussion Hub connection error:", err);
                });
        })();
    </script>
}
