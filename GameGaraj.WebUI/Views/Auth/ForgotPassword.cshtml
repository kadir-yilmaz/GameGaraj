@{
    Layout = "_AuthLayout";
    int step = ViewBag.Step != null ? (int)ViewBag.Step : 1;
    ViewData["Title"] = step == 2 ? "Şifre Sıfırlama Kodu" : "Şifremi Unuttum";
}

<style>
    .auth-box {
        width: 100%;
        max-width: 440px;
        background: #131b2e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 32px 28px;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(12px);
    }

    .auth-header {
        text-align: center;
        margin-bottom: 24px;
    }

    .auth-icon-badge {
        width: 52px;
        height: 52px;
        background: rgba(255, 107, 0, 0.12);
        color: var(--gg-primary, #ff6b00);
        border: 1px solid rgba(255, 107, 0, 0.25);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 14px;
    }

    .auth-title {
        font-size: 1.55rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.3px;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        font-size: 0.86rem;
        color: #94a3b8;
        margin: 0;
        line-height: 1.45;
    }

    .auth-form-group {
        margin-bottom: 18px;
    }

    .auth-input-label {
        font-size: 0.82rem;
        font-weight: 700;
        color: #cbd5e1;
        margin-bottom: 6px;
        display: block;
    }

    .auth-input-container {
        position: relative;
        display: flex;
        align-items: center;
    }

    .auth-input-container i.input-icon {
        position: absolute;
        left: 14px;
        color: #64748b;
        font-size: 0.95rem;
        pointer-events: none;
        transition: color 0.2s ease;
        z-index: 2;
    }

    .auth-input-field {
        width: 100%;
        height: 44px;
        background: #0b1120;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        padding: 0 16px 0 38px;
        font-size: 0.92rem;
        color: #f8fafc;
        transition: all 0.2s ease;
        outline: none;
    }

    .auth-input-field:focus {
        border-color: var(--gg-primary, #ff6b00);
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.18);
        background: #0f172a;
    }

    .auth-input-field:focus + i.input-icon,
    .auth-input-container:focus-within i.input-icon {
        color: var(--gg-primary, #ff6b00);
    }

    .otp-field {
        letter-spacing: 10px;
        font-size: 1.4rem !important;
        font-weight: 800;
        text-align: center;
        padding: 0 10px !important;
        font-family: 'Courier New', monospace;
        color: #ff6b00 !important;
        background: #080d1a !important;
        border: 2px dashed rgba(255, 107, 0, 0.4) !important;
    }

    .otp-field:focus {
        border-color: #ff6b00 !important;
        box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.25) !important;
    }

    .auth-password-toggle {
        position: absolute;
        right: 14px;
        color: #64748b;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        font-size: 0.95rem;
        transition: color 0.2s;
        z-index: 2;
    }

    .auth-password-toggle:hover {
        color: #cbd5e1;
    }

    .auth-btn-submit {
        width: 100%;
        height: 44px;
        background: linear-gradient(135deg, #ff6b00, #ea580c);
        color: #ffffff;
        border: none;
        border-radius: 10px;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        box-shadow: 0 6px 18px rgba(255, 107, 0, 0.28);
        transition: all 0.2s ease;
        text-decoration: none;
        margin-top: 6px;
    }

    .auth-btn-submit:hover {
        background: linear-gradient(135deg, #ea580c, #c2410c);
        box-shadow: 0 8px 24px rgba(255, 107, 0, 0.38);
        transform: translateY(-1px);
        color: #ffffff;
    }

    .auth-footer-prompt {
        text-align: center;
        font-size: 0.85rem;
        color: #94a3b8;
        margin-top: 22px;
        margin-bottom: 0;
    }

    .auth-footer-prompt a {
        color: var(--gg-primary, #ff6b00);
        text-decoration: none;
        font-weight: 700;
        margin-left: 4px;
    }

    .auth-footer-prompt a:hover {
        text-decoration: underline;
        color: #fb923c;
    }

    .auth-validation-error {
        color: #ef4444;
        font-size: 0.78rem;
        font-weight: 600;
        margin-top: 4px;
        display: block;
    }
</style>

<div class="auth-box">
    @if (step == 1)
    {
        @* --- ADIM 1: E-POSTA İLE DOĞRULAMA KODU İSTEME --- *@
        var emailModel = Model as GameGaraj.WebUI.Models.Auth.ForgotPasswordViewModel ?? new GameGaraj.WebUI.Models.Auth.ForgotPasswordViewModel();

        <div class="auth-header">
            <div class="auth-icon-badge">
                <i class="fas fa-key"></i>
            </div>
            <h1 class="auth-title">Şifremi Unuttum</h1>
            <p class="auth-subtitle">
                Hesabınıza kayıtlı e-posta adresinizi girin, size 6 haneli doğrulama kodu gönderelim.
            </p>
        </div>

        <form asp-action="SendResetOtp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <div class="auth-form-group">
                <label class="auth-input-label">E-posta Adresi</label>
                <div class="auth-input-container">
                    <i class="fas fa-envelope input-icon"></i>
                    <input name="Email" value="@emailModel.Email" type="email" class="auth-input-field" required autocomplete="email" placeholder="ornek@gamegaraj.com" autofocus />
                </div>
            </div>

            <button type="submit" class="auth-btn-submit">
                <i class="fas fa-paper-plane"></i>
                <span>Doğrulama Kodu Gönder</span>
            </button>

            <p class="auth-footer-prompt">
                Şifrenizi hatırladınız mı?<a asp-action="SignIn">Giriş Yap</a>
            </p>
        </form>
    }
    else
    {
        @* --- ADIM 2: 6 HANELİ KOD & YENİ ŞİFRE GİRİŞİ --- *@
        var otpModel = Model as GameGaraj.WebUI.Models.Auth.ResetPasswordOtpViewModel ?? new GameGaraj.WebUI.Models.Auth.ResetPasswordOtpViewModel();

        <div class="auth-header">
            <div class="auth-icon-badge">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h1 class="auth-title">Yeni Şifre Belirle</h1>
            <p class="auth-subtitle">
                <strong class="text-white">@otpModel.Email</strong> adresinize gönderilen 6 haneli kodu ve yeni şifrenizi giriniz.
            </p>
        </div>

        <form asp-action="ResetPasswordWithOtp" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center"></div>

            <input type="hidden" name="Email" value="@otpModel.Email" />

            <div class="auth-form-group">
                <label class="auth-input-label">6 Haneli Doğrulama Kodu</label>
                <div class="auth-input-container">
                    <input name="OtpCode" value="@otpModel.OtpCode" type="text" maxlength="6" class="auth-input-field otp-field" required autocomplete="one-time-code" placeholder="000000" autofocus />
                </div>
            </div>

            <div class="auth-form-group">
                <label class="auth-input-label">Yeni Şifre</label>
                <div class="auth-input-container">
                    <i class="fas fa-lock input-icon"></i>
                    <input name="NewPassword" id="newPassword" type="password" class="auth-input-field" required placeholder="••••••••" style="padding-right: 40px;" />
                    <button type="button" class="auth-password-toggle" onclick="togglePass('newPassword', 'toggleIcon1')">
                        <i class="fas fa-eye" id="toggleIcon1"></i>
                    </button>
                </div>
            </div>

            <div class="auth-form-group">
                <label class="auth-input-label">Yeni Şifre (Tekrar)</label>
                <div class="auth-input-container">
                    <i class="fas fa-lock input-icon"></i>
                    <input name="ConfirmPassword" id="confirmPassword" type="password" class="auth-input-field" required placeholder="••••••••" style="padding-right: 40px;" />
                    <button type="button" class="auth-password-toggle" onclick="togglePass('confirmPassword', 'toggleIcon2')">
                        <i class="fas fa-eye" id="toggleIcon2"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="auth-btn-submit">
                <i class="fas fa-check-circle"></i>
                <span>Şifremi Güncelle</span>
            </button>

            <div class="d-flex justify-content-between align-items-center mt-3 small">
                <a asp-action="ForgotPassword" asp-route-email="@otpModel.Email" asp-route-step="1" class="text-muted text-decoration-none">
                    <i class="fas fa-redo me-1"></i> Yeni Kod İste
                </a>
                <a asp-action="SignIn" class="text-muted text-decoration-none">
                    Giriş Sayfası
                </a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        function togglePass(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
