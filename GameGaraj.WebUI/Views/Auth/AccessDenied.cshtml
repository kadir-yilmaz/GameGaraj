@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "403 - Yetkisiz Erişim";
    ViewData["HideBackBtn"] = true;
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/admin";
    var userEmail = User.Identity?.Name ?? User.Claims.FirstOrDefault(c => c.Type == "email" || c.Type == System.Security.Claims.ClaimTypes.Email)?.Value;
    var loginUrl = Url.Action("SignOut", "Auth", new { returnUrl = Url.Action("SignIn", "Auth", new { returnUrl }) });
}

<style>
    .denied-card {
        width: 100%;
        max-width: 420px;
        background: #131b2e;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 36px 28px;
        box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.04);
        backdrop-filter: blur(12px);
        text-align: center;
    }

    .denied-icon-wrap {
        width: 60px;
        height: 60px;
        margin: 0 auto 18px;
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .denied-icon-wrap i {
        font-size: 24px;
        color: #ef4444;
    }

    .denied-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #ffffff;
        letter-spacing: -0.3px;
        margin-bottom: 6px;
    }

    .denied-desc {
        font-size: 0.88rem;
        color: #94a3b8;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .denied-account {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 10px;
        padding: 8px 14px;
        margin-bottom: 24px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        max-width: 100%;
    }

    .denied-btn-primary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 46px;
        background: #ff6b00;
        border: none;
        border-radius: 10px;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(255, 107, 0, 0.25);
    }

    .denied-btn-primary:hover {
        background: #ea580c;
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(255, 107, 0, 0.35);
    }

    .denied-btn-secondary {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 44px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        color: #cbd5e1;
        font-weight: 600;
        font-size: 0.88rem;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .denied-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.16);
        color: #ffffff;
    }
</style>

<div class="denied-card">
    <!-- Icon -->
    <div class="denied-icon-wrap">
        <i class="fa-solid fa-lock"></i>
    </div>

    <!-- Title & Desc -->
    <h1 class="denied-title">Yetkisiz Erişim (403)</h1>
    <p class="denied-desc">
        Bu sayfayı görüntülemek için <strong style="color: #f1f5f9;">Admin</strong> yetkisine sahip bir hesap ile giriş yapmalısınız.
    </p>

    @if (!string.IsNullOrEmpty(userEmail))
    {
        <!-- Current Logged In Account Pill -->
        <div class="denied-account">
            <i class="fa-regular fa-user" style="color: #64748b; font-size: 13px;"></i>
            <span style="color: #64748b; font-size: 12px;">Aktif:</span>
            <span style="color: #e2e8f0; font-size: 12px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@userEmail</span>
        </div>
    }

    <!-- Action Buttons -->
    <div style="display: flex; flex-direction: column; gap: 10px;">
        <!-- Logout & Login Action -->
        <a href="@loginUrl" class="denied-btn-primary">
            <i class="fa-solid fa-right-from-bracket"></i>
            Çıkış Yap ve Yönetici ile Giriş Yap
        </a>

        <!-- Return to Home -->
        <a href="/" class="denied-btn-secondary">
            <i class="fa-solid fa-store"></i>
            Mağazaya Dön
        </a>
    </div>
</div>
