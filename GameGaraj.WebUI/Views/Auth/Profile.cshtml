@model GameGaraj.WebUI.Models.Auth.ProfileViewModel
@{
    ViewData["Title"] = "Profilim & Hesap Güvenliği";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var initials = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : (Model.Email.Length > 0 ? Model.Email.Substring(0, 1).ToUpper() : "U");
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Ana Sayfa</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Profilim</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-dark mb-0">
                <i class="fas fa-user-shield text-primary me-2"></i>Hesap ve Profil Yönetimi
            </h2>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-controller="Auth" asp-action="SignOut" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sol Kolon: Kullanıcı Kartı & Hızlı Bağlantılar -->
        <div class="col-lg-4">
            <!-- Profil Kartı -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="bg-primary bg-gradient p-4 text-center text-white position-relative">
                    <div class="rounded-circle bg-white text-primary fw-bold shadow mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                        @initials
                    </div>
                    <h5 class="fw-bold mb-1">@(string.IsNullOrWhiteSpace(Model.FullName) ? "GameGaraj Kullanıcısı" : Model.FullName)</h5>
                    <p class="text-white-50 small mb-2"><i class="fa-regular fa-envelope me-1"></i>@Model.Email</p>
                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                        @if (Model.Roles != null && Model.Roles.Any())
                        {
                            foreach (var r in Model.Roles)
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 small"><i class="fas fa-shield-alt me-1"></i>@r</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-light text-dark px-2 py-1 small">Müşteri</span>
                        }
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush rounded-2">
                        <a asp-controller="Order" asp-action="History" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-box text-primary me-2" style="width: 20px;"></i>Siparişlerim</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Reviews" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-comments text-info me-2" style="width: 20px;"></i>Yorumlarım</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Order" asp-action="MyCoupons" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-ticket-alt text-warning me-2" style="width: 20px;"></i>Kuponlarım</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Address" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-map-marker-alt text-danger me-2" style="width: 20px;"></i>Kayıtlı Adreslerim</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Favorites" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-heart text-danger me-2" style="width: 20px;"></i>Favorilerim</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                        <a asp-controller="Order" asp-action="Notifications" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-2 border-0">
                            <span><i class="fas fa-bell text-secondary me-2" style="width: 20px;"></i>Bildirimlerim</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Hesap Bilgileri & Şifre Değiştirme Formu -->
        <div class="col-lg-8">
            <!-- 1. Kişisel ve Hesap Detayları -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 px-4 border-bottom">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="fas fa-id-card text-primary me-2"></i>Hesap Bilgileri
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Ad</label>
                            <input type="text" class="form-control bg-light" value="@Model.Name" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-semibold">Soyad</label>
                            <input type="text" class="form-control bg-light" value="@Model.Surname" readonly />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-semibold">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-regular fa-envelope text-muted"></i></span>
                                <input type="email" class="form-control bg-light" value="@Model.Email" readonly />
                                <span class="input-group-text bg-success bg-opacity-10 text-success small"><i class="fas fa-check-circle me-1"></i>Doğrulanmış</span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-semibold">Keycloak Kullanıcı Kimliği (ID)</label>
                            <input type="text" class="form-control font-monospace bg-light small" style="font-size: 0.85rem;" value="@Model.UserId" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Şifre ve Güvenlik -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="fas fa-key text-warning me-2"></i>Şifre Değiştir
                    </h5>
                    <span class="badge bg-light text-muted small">Keycloak IAM</span>
                </div>
                <div class="card-body p-4">
                    <form id="form-change-password" onsubmit="handleChangePassword(event)">
                        <div id="change-pass-alert" class="alert d-none mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Yeni Şifre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                    <input type="password" id="newPassword" class="form-control" placeholder="En az 6 karakter" required minlength="6" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">Yeni Şifre Tekrar</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                                    <input type="password" id="confirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" required minlength="6" />
                                </div>
                            </div>
                            <div class="col-12 text-end mt-4">
                                <button type="submit" id="btn-save-pass" class="btn btn-primary px-4 rounded-pill">
                                    <i class="fas fa-save me-1"></i>Şifreyi Güncelle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function handleChangePassword(e) {
        e.preventDefault();
        const newPass = document.getElementById('newPassword').value;
        const confirmPass = document.getElementById('confirmPassword').value;
        const alertEl = document.getElementById('change-pass-alert');
        const btn = document.getElementById('btn-save-pass');

        alertEl.className = 'alert d-none';

        if (newPass !== confirmPass) {
            alertEl.className = 'alert alert-danger';
            alertEl.innerText = 'Şifreler birbiriyle uyuşmuyor.';
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Güncelleniyor...';

        try {
            const res = await fetch('/Auth/ChangePassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newPassword: newPass, confirmPassword: confirmPass })
            });

            const data = await res.json();
            if (data.success) {
                alertEl.className = 'alert alert-success';
                alertEl.innerText = '✅ Şifreniz başarıyla güncellendi!';
                document.getElementById('form-change-password').reset();
            } else {
                alertEl.className = 'alert alert-danger';
                alertEl.innerText = '❌ ' + (data.message || 'Şifre güncellenirken bir hata oluştu.');
            }
        } catch (err) {
            alertEl.className = 'alert alert-danger';
            alertEl.innerText = 'Bağlantı hatası oluştu: ' + err;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-1"></i>Şifreyi Güncelle';
        }
    }
</script>
