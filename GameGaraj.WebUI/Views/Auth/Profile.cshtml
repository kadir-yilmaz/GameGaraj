@model GameGaraj.WebUI.Models.Auth.ProfileViewModel
@{
    ViewData["Title"] = "Profilim & Hesap Bilgileri";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var displayName = string.IsNullOrWhiteSpace(Model.FullName) ? "GameGaraj Kullanıcısı" : Model.FullName;
    var initials = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName[..1].ToUpperInvariant()
        : (Model.Email.Length > 0 ? Model.Email[..1].ToUpperInvariant() : "U");
}

@section Styles {
    <style>
        .gg-profile-page {
            color: #e2e8f0;
        }
        .gg-profile-card {
            background: #1e2631;
            border: 1px solid #334155;
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
        }
        .gg-profile-hero {
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 55%, #1e40af 100%);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .gg-profile-avatar {
            width: 84px;
            height: 84px;
            font-size: 2rem;
            background: rgba(255, 255, 255, 0.96);
            color: #1d4ed8;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }
        .gg-nav-link {
            background: transparent;
            color: #cbd5e1;
            border: 1px solid transparent;
            border-radius: 10px;
            transition: all 0.18s ease;
        }
        .gg-nav-link:hover {
            background: rgba(59, 130, 246, 0.12);
            border-color: rgba(59, 130, 246, 0.28);
            color: #ffffff;
            transform: translateX(3px);
        }
        .gg-card-header {
            background: rgba(15, 23, 42, 0.45);
            border-bottom: 1px solid #334155;
            border-radius: 16px 16px 0 0 !important;
        }
        .gg-input {
            background-color: #131922 !important;
            border: 1px solid #334155 !important;
            color: #f8fafc !important;
            border-radius: 10px;
            padding: 0.65rem 0.9rem;
        }
        .gg-input:focus {
            background-color: #0f172a !important;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.2) !important;
        }
        .gg-input[readonly] {
            background-color: #161d27 !important;
            color: #94a3b8 !important;
            cursor: not-allowed;
        }
        .gg-input-addon {
            background-color: #161d27 !important;
            border: 1px solid #334155 !important;
            color: #94a3b8 !important;
        }
        .gg-info-banner {
            background: rgba(59, 130, 246, 0.1);
            border: 1px solid rgba(59, 130, 246, 0.25);
            color: #bfdbfe;
            border-radius: 12px;
        }
    </style>
}

<div class="container py-4 gg-profile-page">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-secondary">Ana Sayfa</a></li>
                    <li class="breadcrumb-item active text-light" aria-current="page">Profilim</li>
                </ol>
            </nav>
            <h2 class="h3 fw-bold text-white mb-0">
                <i class="fas fa-user-shield text-primary me-2"></i>Hesap ve Profil Yönetimi
            </h2>
        </div>
        <div class="mt-2 mt-sm-0">
            <a asp-controller="Auth" asp-action="SignOut" class="btn btn-outline-danger btn-sm px-3 rounded-pill">
                <i class="fas fa-sign-out-alt me-1"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sol Kolon: Kullanıcı Kartı & Hızlı Bağlantılar -->
        <div class="col-lg-4">
            <div class="gg-profile-card overflow-hidden">
                <div class="gg-profile-hero p-4 text-center text-white">
                    <div id="profile-avatar" class="rounded-circle gg-profile-avatar fw-bold mx-auto d-flex align-items-center justify-content-center mb-3">
                        @initials
                    </div>
                    <h5 id="profile-display-name" class="fw-bold mb-1">@displayName</h5>
                    <p class="text-white-50 small mb-3"><i class="fa-regular fa-envelope me-1"></i>@Model.Email</p>
                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                        @if (Model.Roles != null && Model.Roles.Any())
                        {
                            foreach (var r in Model.Roles)
                            {
                                <span class="badge bg-warning text-dark px-2 py-1 small"><i class="fas fa-shield-alt me-1"></i>@r</span>
                            }
                        }
                        else
                        {
                            <span class="badge bg-light text-dark px-2 py-1 small">Müşteri</span>
                        }
                    </div>
                </div>
                <div class="p-3">
                    <div class="d-grid gap-1">
                        <a asp-controller="Order" asp-action="History" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-box text-primary me-2" style="width: 20px;"></i>Siparişlerim</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                        <a asp-controller="Reviews" asp-action="Index" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-comments text-info me-2" style="width: 20px;"></i>Yorumlarım</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                        <a asp-controller="Order" asp-action="MyCoupons" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-ticket-alt text-warning me-2" style="width: 20px;"></i>Kuponlarım</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                        <a asp-controller="Address" asp-action="Index" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-map-marker-alt text-danger me-2" style="width: 20px;"></i>Kayıtlı Adreslerim</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                        <a asp-controller="Favorites" asp-action="Index" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-heart text-danger me-2" style="width: 20px;"></i>Favorilerim</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                        <a asp-controller="Order" asp-action="Notifications" class="gg-nav-link text-decoration-none d-flex justify-content-between align-items-center py-2 px-3">
                            <span><i class="fas fa-bell text-secondary me-2" style="width: 20px;"></i>Bildirimlerim</span>
                            <i class="fas fa-chevron-right text-secondary small"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Düzenlenebilir Hesap Bilgileri -->
        <div class="col-lg-8">
            <div class="gg-profile-card mb-4">
                <div class="gg-card-header py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-white mb-0">
                        <i class="fas fa-id-card text-primary me-2"></i>Hesap Bilgileri
                    </h5>
                    <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-25">Keycloak Hesabı</span>
                </div>
                <div class="p-4">
                    <form id="form-update-profile" onsubmit="handleUpdateProfile(event)">
                        <div id="profile-alert" class="alert d-none mb-3" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="firstName" class="form-label text-secondary small fw-semibold">Ad</label>
                                <input type="text" id="firstName" class="form-control gg-input" value="@Model.Name" required minlength="2" maxlength="50" placeholder="Adınız" />
                            </div>
                            <div class="col-md-6">
                                <label for="lastName" class="form-label text-secondary small fw-semibold">Soyad</label>
                                <input type="text" id="lastName" class="form-control gg-input" value="@Model.Surname" required minlength="2" maxlength="50" placeholder="Soyadınız" />
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">E-Posta Adresi</label>
                                <div class="input-group">
                                    <span class="input-group-text gg-input-addon"><i class="fa-regular fa-envelope"></i></span>
                                    <input type="email" class="form-control gg-input" value="@Model.Email" readonly />
                                    <span class="input-group-text bg-success bg-opacity-10 border-success border-opacity-25 text-success small">
                                        <i class="fas fa-check-circle me-1"></i>Doğrulanmış
                                    </span>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label text-secondary small fw-semibold">Kullanıcı Kimliği (ID)</label>
                                <input type="text" class="form-control gg-input font-monospace small" style="font-size: 0.85rem;" value="@Model.UserId" readonly />
                            </div>
                            <div class="col-12 d-flex justify-content-end mt-4">
                                <button type="submit" id="btn-save-profile" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                                    <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="gg-info-banner p-3 d-flex align-items-center gap-3 small">
                <i class="fas fa-key fa-lg text-info"></i>
                <div>
                    <strong>Şifre İşlemleri:</strong> Güvenlik nedeniyle şifre sıfırlama işlemleri yalnızca giriş ekranındaki
                    <span class="text-white fw-semibold">Şifremi unuttum</span> adımı üzerinden yapılmaktadır.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function handleUpdateProfile(e) {
            e.preventDefault();
            const firstName = document.getElementById('firstName').value.trim();
            const lastName = document.getElementById('lastName').value.trim();
            const alertEl = document.getElementById('profile-alert');
            const btn = document.getElementById('btn-save-profile');

            alertEl.className = 'alert d-none';
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Kaydediliyor...';

            try {
                const res = await fetch('/Auth/UpdateProfile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ firstName, lastName })
                });

                const data = await res.json();
                if (data.success) {
                    alertEl.className = 'alert alert-success';
                    alertEl.textContent = '✅ ' + (data.message || 'Profil bilgileriniz güncellendi.');
                    document.getElementById('profile-display-name').textContent = data.fullName || `${firstName} ${lastName}`;
                    if (firstName.length > 0) {
                        document.getElementById('profile-avatar').textContent = firstName[0].toUpperCase();
                    }
                } else {
                    alertEl.className = 'alert alert-danger';
                    alertEl.textContent = '❌ ' + (data.message || 'Profil güncellenirken bir hata oluştu.');
                }
            } catch (err) {
                alertEl.className = 'alert alert-danger';
                alertEl.textContent = 'Bağlantı hatası oluştu.';
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-2"></i>Değişiklikleri Kaydet';
            }
        }
    </script>
}
